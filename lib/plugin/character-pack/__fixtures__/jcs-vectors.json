{
  "version": 1,
  "note": "RFC 8785 golden vectors. Consumed by BOTH lib/plugin/character-pack/canonical-json.test.ts (Jest) and crates/cognia-cli/src/engine/canonical_json.rs (include_str!). The two sides must agree byte-for-byte or signed packs verify on one and not the other.",
  "vectors": [
    {
      "name": "empty object",
      "input": {},
      "expected": "{}"
    },
    {
      "name": "empty array",
      "input": [],
      "expected": "[]"
    },
    {
      "name": "top-level null",
      "input": null,
      "expected": "null"
    },
    {
      "name": "top-level true",
      "input": true,
      "expected": "true"
    },
    {
      "name": "top-level number",
      "input": 42,
      "expected": "42"
    },
    {
      "name": "top-level string",
      "input": "hi",
      "expected": "\"hi\""
    },
    {
      "name": "key ordering ascii",
      "input": {
        "b": 1,
        "a": 2,
        "C": 3,
        "_": 4
      },
      "expected": "{\"C\":3,\"_\":4,\"a\":2,\"b\":1}"
    },
    {
      "name": "key ordering digits are lexical not numeric",
      "input": {
        "1": 3,
        "2": 2,
        "10": 1
      },
      "expected": "{\"1\":3,\"10\":1,\"2\":2}"
    },
    {
      "name": "integer-like keys are not hoisted ahead of string keys",
      "input": {
        "b": 1,
        "10": 2,
        "a": 3,
        "2": 4
      },
      "expected": "{\"10\":2,\"2\":4,\"a\":3,\"b\":1}"
    },
    {
      "name": "empty key sorts first",
      "input": {
        "": 1,
        "a": 2
      },
      "expected": "{\"\":1,\"a\":2}"
    },
    {
      "name": "key ordering utf16 astral before bmp",
      "input": {
        "דּ": "bmp",
        "😂": "astral"
      },
      "expected": "{\"😂\":\"astral\",\"דּ\":\"bmp\"}"
    },
    {
      "name": "non-ascii keys",
      "input": {
        "€": 1,
        "日": 2,
        "z": 3
      },
      "expected": "{\"z\":3,\"€\":1,\"日\":2}"
    },
    {
      "name": "array order preserved under reversed-key objects",
      "input": [
        {
          "b": 1,
          "a": 2
        },
        {
          "d": 3,
          "c": 4
        }
      ],
      "expected": "[{\"a\":2,\"b\":1},{\"c\":4,\"d\":3}]"
    },
    {
      "name": "nested structures",
      "input": {
        "z": {
          "y": [
            1,
            {
              "x": 2,
              "w": 3
            }
          ]
        },
        "a": null
      },
      "expected": "{\"a\":null,\"z\":{\"y\":[1,{\"w\":3,\"x\":2}]}}"
    },
    {
      "name": "numbers",
      "input": {
        "a": 0,
        "b": 0,
        "c": 1,
        "d": -1,
        "e": 0.1,
        "f": 1e21,
        "g": 1e-7,
        "h": 9007199254740992,
        "i": 5e-324,
        "j": 1.7976931348623157e308
      },
      "expected": "{\"a\":0,\"b\":0,\"c\":1,\"d\":-1,\"e\":0.1,\"f\":1e+21,\"g\":1e-7,\"h\":9007199254740992,\"i\":5e-324,\"j\":1.7976931348623157e+308}"
    },
    {
      "name": "c0 control sweep",
      "input": {
        "s": "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\t\n\u000b\f\r\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f"
      },
      "expected": "{\"s\":\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n\\u000b\\f\\r\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"}"
    },
    {
      "name": "short escapes",
      "input": {
        "s": "\b\t\n\f\r\"\\"
      },
      "expected": "{\"s\":\"\\b\\t\\n\\f\\r\\\"\\\\\"}"
    },
    {
      "name": "del stays literal",
      "input": {
        "s": ""
      },
      "expected": "{\"s\":\"\"}"
    },
    {
      "name": "cjk and emoji",
      "input": {
        "s": "中文 😂"
      },
      "expected": "{\"s\":\"中文 😂\"}"
    },
    {
      "name": "undefined properties are dropped",
      "input": {
        "a": 1,
        "c": 3
      },
      "expected": "{\"a\":1,\"c\":3}"
    },
    {
      "name": "realistic character pack with all eight requires dimensions",
      "input": {
        "version": "1.2.0",
        "id": "demo.pack",
        "name": "Demo",
        "tags": ["b", "a"],
        "requires": {
          "providers": ["anthropic"],
          "connectors": ["telegram"],
          "themePacks": ["plugin-a.pack-b"],
          "skills": ["s1"],
          "pluginSkillIds": ["ps1"],
          "mcpServerPresets": ["mcp1"],
          "nativeAnthropicTools": ["bash"],
          "a2uiCatalogId": "cat"
        },
        "characters": [
          {
            "localId": "c1",
            "name": "One",
            "avatarColor": "#ffffff",
            "systemPrompt": "you are one",
            "voiceProfile": {
              "rate": 1.1
            },
            "persona": {
              "exemplarPrompts": ["z", "a"]
            },
            "avatarImage": {
              "webDataUrl": "data:image/png;base64,iVBORw0KGgo="
            }
          }
        ]
      },
      "expected": "{\"characters\":[{\"avatarColor\":\"#ffffff\",\"avatarImage\":{\"webDataUrl\":\"data:image/png;base64,iVBORw0KGgo=\"},\"localId\":\"c1\",\"name\":\"One\",\"persona\":{\"exemplarPrompts\":[\"z\",\"a\"]},\"systemPrompt\":\"you are one\",\"voiceProfile\":{\"rate\":1.1}}],\"id\":\"demo.pack\",\"name\":\"Demo\",\"requires\":{\"a2uiCatalogId\":\"cat\",\"connectors\":[\"telegram\"],\"mcpServerPresets\":[\"mcp1\"],\"nativeAnthropicTools\":[\"bash\"],\"pluginSkillIds\":[\"ps1\"],\"providers\":[\"anthropic\"],\"skills\":[\"s1\"],\"themePacks\":[\"plugin-a.pack-b\"]},\"tags\":[\"b\",\"a\"],\"version\":\"1.2.0\"}"
    }
  ]
}

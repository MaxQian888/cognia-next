{
  "name": "workspace-extension",
  "publisher": "cognia",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Fixture",
      "properties": {
        "fixture.greeting": {
          "type": "string",
          "default": "Hello"
        },
        "fixture.server.port": {
          "type": "number",
          "default": 8080
        }
      }
    }
  }
}

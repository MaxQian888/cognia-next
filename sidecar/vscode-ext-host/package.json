{
  "name": "@cognia/vscode-ext-host",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js host process for VS Code extensions running inside cognia. Spawned by Tauri; speaks JSON-RPC over stdio to the renderer.",
  "main": "dist/host.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-vm-modules tests/*.test.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  }
}

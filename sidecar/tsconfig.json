{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsc/sidecar.tsbuildinfo"
  },
  // The launchers are roots so the program is never empty while `src/` fills up.
  "include": ["*.mjs", "codex-app-control/**/*", "src/**/*", "test-support/**/*"],
  "exclude": [
    "cognia-mcp.mjs",
    "a2ui-mcp.mjs",
    "node_modules",
    "pi-extension",
    "vscode-ext-host",
    "webclone",
    "codeserver-agent-ext"
  ]
}

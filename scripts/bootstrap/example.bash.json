{
  "version": 1,
  "task": "Prepare this workspace and ensure the readiness checks pass.",
  "model": {
    "baseUrl": "https://your-compatible-provider.example/v1",
    "model": "your-model-id",
    "apiKeyEnv": "COGNIA_BOOTSTRAP_API_KEY",
    "stream": true
  },
  "tools": {
    "profile": "dsh",
    "shellExecutable": "/bin/bash",
    "shellArgs": ["--noprofile", "--norc"]
  },
  "setupCommand": "mkdir -p .bootstrap && printf ready > .bootstrap/ready",
  "checks": [{ "name": "ready", "command": "test -f .bootstrap/ready" }],
  "reuse": { "inputs": [], "outputs": [".bootstrap/ready"] },
  "limits": { "maxSteps": 32, "totalTimeoutSecs": 600, "commandTimeoutSecs": 60 }
}

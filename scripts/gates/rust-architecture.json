{
  "$comment": "The Rust workspace layer map (ADR-0196), enforced by scripts/gates/check-rust-architecture.mjs. A crate may depend on crates in lower layers; a same-layer edge must be listed in allowedSameLayer. New Rust logic goes in the lowest-layer crate under crates/ that can own it; src-tauri only assembles the desktop app.",
  "layers": ["foundation", "platform", "domain", "companion", "service", "app"],
  "crates": {
    "cognia-problem": "foundation",
    "cognia-canonical-json": "foundation",
    "cognia-instrument": "foundation",
    "cognia-core": "foundation",
    "cognia-git-mirror": "foundation",
    "cognia-headless-contract": "foundation",
    "cognia-secrets": "foundation",
    "cognia-net": "foundation",
    "cognia-tenant-auth": "foundation",
    "cognia-deployment": "foundation",

    "cognia-jobs": "platform",
    "cognia-environment": "platform",
    "cognia-agents": "platform",
    "cognia-files": "platform",
    "cognia-media": "platform",
    "cognia-sandboxd": "platform",

    "cognia-git": "domain",
    "cognia-ocr": "domain",
    "cognia-vector": "domain",
    "cognia-automation": "domain",
    "cognia-scheduling": "domain",
    "cognia-terminal": "domain",
    "cognia-subscription": "domain",
    "cognia-connectors": "domain",
    "cognia-plugin-runtime": "domain",
    "cognia-skills": "domain",
    "cognia-tts": "domain",
    "cognia-gateway": "domain",
    "cognia-ccswitch": "domain",
    "cognia-mcp-server": "domain",
    "cognia-external-agent": "domain",
    "cognia-task-workspace": "domain",
    "cognia-observability": "domain",
    "cognia-agent-state": "domain",
    "cognia-sandbox-pool": "domain",

    "cognia-cli": "service",
    "cognia-collab-server": "service",
    "cognia-ops-controller": "service",
    "cognia-deploy-agent": "service",
    "cognia-sandbox-runner": "service",

    "cognia-next": "app"
  },
  "allowedSameLayer": [
    "cognia-core -> cognia-problem",
    "cognia-secrets -> cognia-core",
    "cognia-ccswitch -> cognia-subscription",
    "cognia-mcp-server -> cognia-automation",
    "cognia-plugin-runtime -> cognia-terminal",
    "cognia-agent-state -> cognia-gateway",
    "cognia-sandbox-pool -> cognia-external-agent"
  ],
  "forbidden": [
    {
      "from": { "layer": "foundation" },
      "reach": [
        "tauri",
        "tauri-plugin-*",
        "wry",
        "rquickjs",
        "wasmtime",
        "wasmtime-*",
        "matrix-sdk",
        "matrix-sdk-*",
        "uiautomation",
        "webrtc"
      ],
      "reason": "foundation crates are linked by everything, including the CLI and the in-sandbox supervisor; a heavy engine here is paid by every crate above"
    },
    {
      "from": { "crates": ["cognia-sandboxd"] },
      "reach": ["cognia-net", "cognia-environment", "reqwest"],
      "reason": "cognia-sandboxd is a static musl binary inside the sandbox; it must not link a network stack"
    }
  ],
  "directOnly": [
    {
      "dep": "keyring",
      "allowed": ["cognia-secrets", "cognia-next"],
      "reason": "OS credential access goes through cognia-secrets; the app keeps its per-target keyring backend declarations"
    }
  ],
  "tauri": {
    "allowed": ["cognia-next"],
    "hostFeature": "tauri-host",
    "hostFeatureOverrides": { "cognia-observability": "desktop-host" },
    "enablers": ["cognia-next"]
  },
  "appShell": {
    "package": "cognia-next",
    "srcDir": "src-tauri/src",
    "maxLoc": 188800,
    "locSlack": 4000,
    "locBlocking": false,
    "modules": [
      "a2ui_bridge",
      "account_auth",
      "account_quick_unlock.rs",
      "agent_debug",
      "agent_debug.rs",
      "bin",
      "browser",
      "canvas",
      "capture",
      "chat_copilot",
      "claude",
      "cli_bridge",
      "codeserver",
      "codex_app_dispatch.rs",
      "commands.rs",
      "companion_api",
      "fleet",
      "fonts.rs",
      "gateway_brain_bridge.rs",
      "github",
      "headless",
      "hooks",
      "jobs",
      "keyring_secrets.rs",
      "lib.rs",
      "main.rs",
      "mcp_oauth",
      "mcp_oauth.rs",
      "menu.rs",
      "node_runtime.rs",
      "ollama",
      "parse",
      "perf",
      "pet_window",
      "pi_extension.rs",
      "pi_sessions.rs",
      "power_assertion.rs",
      "process_registry",
      "project_environment.rs",
      "provider_diagnostics.rs",
      "proxy_config",
      "recorder_window",
      "recovery",
      "selection_toolbar.rs",
      "server_ops.rs",
      "session_import.rs",
      "session_import_watch.rs",
      "settings.rs",
      "sftp_service.rs",
      "shell.rs",
      "shortcuts",
      "shutdown.rs",
      "startup",
      "subscription",
      "task_workspace.rs",
      "terminal_host_bridge.rs",
      "tray",
      "turn_provision.rs",
      "twin",
      "usage_dock",
      "voice_live.rs",
      "wake_on_lan.rs",
      "wallpaper",
      "webclone.rs",
      "webview_watchdog.rs",
      "window_behavior.rs",
      "window_recovery.rs",
      "window_utils.rs"
    ]
  }
}

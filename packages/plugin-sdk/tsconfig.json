{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../../*"],
      "@cognia/provider-types": ["../../packages/provider-types/src/index.ts"],
      "@cognia/provider-types/*": ["../../packages/provider-types/src/*"],
      "@cognia/provider-core": ["../../packages/provider-core/src/index.ts"],
      "@cognia/provider-core/*": ["../../packages/provider-core/src/*"],
      "@cognia/provider-embedding": ["../../packages/provider-embedding/src/index.ts"],
      "@cognia/provider-embedding/*": ["../../packages/provider-embedding/src/*"],
      "@cognia/provider-routing": ["../../packages/provider-routing/src/index.ts"],
      "@cognia/provider-routing/*": ["../../packages/provider-routing/src/*"],
      "@cognia/rag": ["../../packages/rag/src/index.ts"],
      "@cognia/rag/*": ["../../packages/rag/src/*"],
      "@cognia/error-parsers": ["../../packages/error-parsers/src/index.ts"],
      "@cognia/error-parsers/*": ["../../packages/error-parsers/src/*"],
      "@cognia/vector": ["../../packages/vector/src/index.ts"],
      "@cognia/vector/*": ["../../packages/vector/src/*"],
      "@cognia/document": ["../../packages/document/src/index.ts"],
      "@cognia/document/*": ["../../packages/document/src/*"],
      "@cognia/agent-trace": ["../../packages/agent-trace/src/index.ts"],
      "@cognia/agent-trace/*": ["../../packages/agent-trace/src/*"],
      "@cognia/primitives": ["../../packages/primitives/src/index.ts"],
      "@cognia/primitives/*": ["../../packages/primitives/src/*"],
      "@cognia/time": ["../../packages/time/src/index.ts"],
      "@cognia/time/*": ["../../packages/time/src/*"],
      "@cognia/latex": ["../../packages/latex/src/index.ts"],
      "@cognia/latex/*": ["../../packages/latex/src/*"],
      "@cognia/mermaid": ["../../packages/mermaid/src/index.ts"],
      "@cognia/mermaid/*": ["../../packages/mermaid/src/*"],
      "@cognia/redact": ["../../packages/redact/src/index.ts"],
      "@cognia/redact/*": ["../../packages/redact/src/*"],
      "@cognia/web-search": ["../../packages/web-search/src/index.ts"],
      "@cognia/web-search/*": ["../../packages/web-search/src/*"],
      "@cognia/logging": ["../../packages/logging/src/index.ts"],
      "@cognia/logging/*": ["../../packages/logging/src/*"],
      "@cognia/agent-config-types": ["../../packages/agent-config-types/src/index.ts"],
      "@cognia/agent-config-types/*": ["../../packages/agent-config-types/src/*"],
      "@cognia/tts": ["../../packages/tts/src/index.ts"],
      "@cognia/tts/*": ["../../packages/tts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../types/optional-modules.d.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../../*"],
      "@cognia/provider-types": ["../../packages/provider-types/src/index.ts"],
      "@cognia/provider-types/*": ["../../packages/provider-types/src/*"],
      "@cognia/provider-core": ["../../packages/provider-core/src/index.ts"],
      "@cognia/provider-core/*": ["../../packages/provider-core/src/*"],
      "@cognia/provider-embedding": ["../../packages/provider-embedding/src/index.ts"],
      "@cognia/provider-embedding/*": ["../../packages/provider-embedding/src/*"],
      "@cognia/provider-routing": ["../../packages/provider-routing/src/index.ts"],
      "@cognia/provider-routing/*": ["../../packages/provider-routing/src/*"],
      "@cognia/rag": ["../../packages/rag/src/index.ts"],
      "@cognia/rag/*": ["../../packages/rag/src/*"],
      "@cognia/error-parsers": ["../../packages/error-parsers/src/index.ts"],
      "@cognia/error-parsers/*": ["../../packages/error-parsers/src/*"],
      "@cognia/diagnostics": ["../../packages/diagnostics/src/index.ts"],
      "@cognia/diagnostics/*": ["../../packages/diagnostics/src/*"],
      "@cognia/vector": ["../../packages/vector/src/index.ts"],
      "@cognia/vector/*": ["../../packages/vector/src/*"],
      "@cognia/document": ["../../packages/document/src/index.ts"],
      "@cognia/document/*": ["../../packages/document/src/*"],
      "@cognia/agent-trace": ["../../packages/agent-trace/src/index.ts"],
      "@cognia/agent-trace/*": ["../../packages/agent-trace/src/*"],
      "@cognia/primitives": ["../../packages/primitives/src/index.ts"],
      "@cognia/primitives/*": ["../../packages/primitives/src/*"],
      "@cognia/time": ["../../packages/time/src/index.ts"],
      "@cognia/time/*": ["../../packages/time/src/*"],
      "@cognia/latex": ["../../packages/latex/src/index.ts"],
      "@cognia/latex/*": ["../../packages/latex/src/*"],
      "@cognia/mermaid": ["../../packages/mermaid/src/index.ts"],
      "@cognia/mermaid/*": ["../../packages/mermaid/src/*"],
      "@cognia/redact": ["../../packages/redact/src/index.ts"],
      "@cognia/redact/*": ["../../packages/redact/src/*"],
      "@cognia/web-search": ["../../packages/web-search/src/index.ts"],
      "@cognia/web-search/*": ["../../packages/web-search/src/*"],
      "@cognia/logging": ["../../packages/logging/src/index.ts"],
      "@cognia/logging/*": ["../../packages/logging/src/*"],
      "@cognia/agent-config-types": ["../../packages/agent-config-types/src/index.ts"],
      "@cognia/agent-config-types/*": ["../../packages/agent-config-types/src/*"],
      "@cognia/tts": ["../../packages/tts/src/index.ts"],
      "@cognia/tts/*": ["../../packages/tts/src/*"],
      "@cognia/ocr": ["../../packages/ocr/src/index.ts"],
      "@cognia/ocr/*": ["../../packages/ocr/src/*"],
      // Reached INDIRECTLY: this package compiles `lib/plugin/api/memory-api.ts`,
      // which imports `@/types/memory/memory` — now a shim over @cognia/memory.
      "@cognia/memory": ["../../packages/memory/src/index.ts"],
      "@cognia/memory/*": ["../../packages/memory/src/*"],
      // Reached INDIRECTLY too, through the host sources this package compiles:
      // `lib/db/schema.ts` re-exports `lib/db/eval-lab.ts` (@cognia/eval-core),
      // `types/browser-companion` re-exports @cognia/companion-client, and
      // `lib/workflow/nodes/ai/browser-model.ts` imports @cognia/transformers-
      // runtime. These `paths` REPLACE the root's, so a package the root
      // resolves is unresolvable here until it is listed by name.
      "@cognia/eval-core": ["../../packages/eval-core/src/index.ts"],
      "@cognia/eval-core/*": ["../../packages/eval-core/src/*"],
      "@cognia/companion-client": ["../../packages/companion-client/src/index.ts"],
      "@cognia/companion-client/*": ["../../packages/companion-client/src/*"],
      "@cognia/transformers-runtime": ["../../packages/transformers-runtime/src/index.ts"],
      "@cognia/transformers-runtime/*": ["../../packages/transformers-runtime/src/*"],
      // Mapped for a DIFFERENT reason than the three above, and it must stay:
      // `@cognia/agent` is the only package in this graph whose `exports` map
      // has no source condition, so unmapped it resolves to its prebuilt
      // `dist/index.d.ts` — and rollup-dts inlines that file's body while
      // leaving its own `./handoff-envelope.js` re-export external. The bundle
      // then ships a relative import resolving against the author's `dist/`,
      // where no such file exists, and EVERY SDK import fails to type-check.
      // Reached via `types/agent/agent-team.ts` -> the deprecated
      // `@cognia/agent-config-types/handoff-envelope` shim -> `@cognia/agent`.
      // `/*` rather than the root tsconfig's three explicit subpaths: that list
      // predates `./worker-manifest` and is already incomplete.
      "@cognia/agent": ["../../packages/agent/src/index.ts"],
      "@cognia/agent/*": ["../../packages/agent/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../types/optional-modules.d.ts"],
  "exclude": ["node_modules", "dist"]
}

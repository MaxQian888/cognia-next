{
  "name": "@cognia/plugin-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Standalone TypeScript SDK for authoring Cognia plugins.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "cognia-source": "./src/manifest/index.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs",
      "default": "./dist/manifest.js"
    },
    "./context": {
      "cognia-source": "./src/context/index.ts",
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs",
      "default": "./dist/context.js"
    },
    "./context/extended": {
      "cognia-source": "./src/context/extended.ts",
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs",
      "default": "./dist/context.js"
    },
    "./contracts": {
      "cognia-source": "./src/contracts/catalog.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs",
      "default": "./dist/contracts.js"
    },
    "./api/tool": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./api/native-anthropic-tool": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./events": {
      "cognia-source": "./src/events/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks": {
      "cognia-source": "./src/hooks/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./permissions": {
      "cognia-source": "./src/permissions/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extensions": {
      "cognia-source": "./src/extensions/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "wit",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/plugin/test-sdk-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cognia",
    "plugin",
    "sdk",
    "tauri"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "@cognia/plugin-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript SDK for authoring Cognia plugins. Stable public façade over the host runtime's plugin contracts (manifest, context, capabilities, registries, hook types).",
  "license": "SEE LICENSE IN ../../LICENSE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./context": "./src/context/index.ts",
    "./context/extended": "./src/context/extended.ts",
    "./api/native-anthropic-tool": "./src/api/native-anthropic-tool.ts",
    "./api/skill": "./src/api/skill.ts",
    "./api/mcp-server-preset": "./src/api/mcp-server-preset.ts",
    "./api/character-pack": "./src/api/character-pack.ts",
    "./api/workflow": "./src/api/workflow.ts",
    "./api/subagent": "./src/api/subagent.ts",
    "./api/agent-team-template": "./src/api/agent-team-template.ts",
    "./api/workflow-template": "./src/api/workflow-template.ts",
    "./api/agent-tool": "./src/api/agent-tool.ts",
    "./api/guardrail": "./src/api/guardrail.ts",
    "./api/context-provider": "./src/api/context-provider.ts",
    "./events": "./src/events/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./permissions": "./src/permissions/index.ts",
    "./extensions": "./src/extensions/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cognia",
    "plugin",
    "sdk",
    "anthropic",
    "tauri"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}

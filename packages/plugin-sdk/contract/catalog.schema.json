{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "minimumHostVersion",
    "apiNamespaces",
    "deprecationPolicy",
    "protocol",
    "contractVersion",
    "pluginTypes",
    "permissions",
    "errorCodes",
    "services",
    "capabilities",
    "manifestContributions",
    "runtimeEntries",
    "pathFields"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minimumHostVersion": {
      "type": "string"
    },
    "pluginTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "realmOverridable"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "realmOverridable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "support", "introducedIn", "minimumHostVersion", "manifestFields"],
        "properties": {
          "id": {
            "type": "string"
          },
          "support": {
            "enum": ["supported", "partial", "experimental", "blocked"]
          },
          "introducedIn": {
            "type": "string"
          },
          "minimumHostVersion": {
            "type": "string"
          },
          "manifestFields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "manifestContributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "capabilities", "execution"],
        "properties": {
          "field": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "execution": {
            "enum": ["host", "javascript", "conditional", "python", "wasm", "vscode"]
          },
          "pythonExecution": {
            "enum": ["supported", "experimental", "unsupported"],
            "description": "Whether a pure-Python (or hybrid python-backed) plugin can supply this contribution's runtime executor via the plugin_python_call seam. Only meaningful for javascript/conditional execution fields; host/data fields are language-agnostic and omit it. Defaults to \"unsupported\" (JS/React only)."
          },
          "entryPath": {
            "type": "string"
          },
          "javascriptWhen": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string"
              },
              "equals": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "runtimeEntries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "javascriptEntry", "javascriptEntryRequiredForContributions"],
        "properties": {
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "javascriptEntry": {
            "type": ["string", "null"]
          },
          "javascriptEntryRequiredForContributions": {
            "type": "boolean"
          },
          "requiredAnyOf": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "pathFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "runtime", "requiredFor", "executable"],
        "properties": {
          "path": {
            "type": "string"
          },
          "runtime": {
            "enum": ["javascript", "python", "wasm", "vscode", "asset"]
          },
          "requiredFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executable": {
            "type": "boolean"
          },
          "sentinels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "contractVersion": {
      "type": "string"
    },
    "protocol": {
      "type": "object",
      "required": [
        "version",
        "minimumSdkVersion",
        "sdkVersion",
        "gatewayClientVersion",
        "minimumGatewayClientVersion",
        "legacyAdapter"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "minimumSdkVersion": {
          "type": "string"
        },
        "sdkVersion": {
          "type": "string"
        },
        "gatewayClientVersion": {
          "type": "string"
        },
        "minimumGatewayClientVersion": {
          "type": "string"
        },
        "legacyAdapter": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "deprecationPolicy": {
      "type": "object",
      "required": ["minimumHostMinorReleases", "removalRequiresSdkMajor"],
      "properties": {
        "minimumHostMinorReleases": {
          "type": "integer",
          "minimum": 1
        },
        "removalRequiresSdkMajor": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "apiNamespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "authorPath",
          "type",
          "stability",
          "introducedIn",
          "runtimes",
          "platforms",
          "transport",
          "factory",
          "enforcement",
          "dataClassification",
          "timeoutMs",
          "retry",
          "errorPolicy",
          "lifecycle",
          "methods"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "authorPath": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "stability": {
            "enum": ["stable", "experimental", "deprecated"]
          },
          "introducedIn": {
            "type": "string"
          },
          "runtimes": {
            "type": "array",
            "items": {
              "enum": ["frontend", "hybrid", "python", "wasm", "vscode"]
            },
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": ["desktop", "web", "mobile", "headless"]
            },
            "uniqueItems": true
          },
          "transport": {
            "enum": ["direct", "gateway", "rpc"]
          },
          "factory": {
            "type": "string"
          },
          "enforcement": {
            "enum": ["shadow", "active"]
          },
          "dataClassification": {
            "enum": ["public", "internal", "sensitive", "secret"]
          },
          "timeoutMs": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "retry": {
            "enum": ["never", "safe", "idempotent"]
          },
          "errorPolicy": {
            "enum": ["preserve", "normalize"]
          },
          "lifecycle": {
            "enum": ["call", "plugin", "host"]
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "requiredPermissions",
                "consentTier",
                "risk",
                "idempotent",
                "cancellable",
                "resourceEffect"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "requiredPermissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "consentTier": {
                  "enum": ["none", "policy", "confirm", "forbid"]
                },
                "risk": {
                  "enum": ["low", "medium", "high", "critical"]
                },
                "idempotent": {
                  "type": "boolean"
                },
                "cancellable": {
                  "type": "boolean"
                },
                "resourceEffect": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "enum": ["none", "returned-disposer", "returned-handle", "host-owned"]
                    },
                    "disposeMethod": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "name": "@cognia/security-findings",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia security-scan core: raw scanner-report normalization, stable finding fingerprints, baseline diffing, SARIF 2.1.0 emit/read, and the severity-threshold gate shared by the Strix plugin and the `cognia-agent security` CLI — framework-agnostic, zero app imports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

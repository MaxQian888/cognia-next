{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../../*"],
      // This package references memory types via `import("@/types/memory/memory")`,
      // and that app path is now a shim re-exporting `@cognia/memory/types/memory`.
      // A child `paths` REPLACES the root's, so the target must be re-listed here
      // or the shim can't resolve during this package's standalone typecheck.
      // Subpath targets are per-file, so only the type module is pulled in — never
      // the memory logic.
      "@cognia/memory": ["../memory/src/index.ts"],
      "@cognia/memory/*": ["../memory/src/*"],
      "@cognia/ocr": ["../ocr/src/index.ts"],
      "@cognia/ocr/*": ["../ocr/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@cognia/agent-config-types",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia agent configuration type hub: AppSettings / SendOptions / ClaudeEvent and their guards — the repo's widest compile boundary (~750 importers), plus the LSP-config, compression, and pet-settings type leaves it depends on.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./claude-agent-sdk-options": {
      "cognia-source": "./src/claude-agent-sdk-options.ts",
      "types": "./src/claude-agent-sdk-options.ts",
      "node": "./dist/claude-agent-sdk-options.js",
      "default": "./src/claude-agent-sdk-options.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/agent": "workspace:*",
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/memory": "workspace:*",
    "@cognia/provider-types": "workspace:*",
    "@cognia/router-fusion": "workspace:*",
    "@cognia/web-search": "workspace:*"
  },
  "peerDependencies": {
    "ai": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1"
  }
}

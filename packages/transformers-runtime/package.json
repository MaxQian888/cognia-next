{
  "name": "@cognia/transformers-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Optional browser model runtime backed by Transformers.js and Web Workers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./capabilities": {
      "cognia-source": "./src/capabilities.ts",
      "default": "./src/capabilities.ts"
    },
    "./models": {
      "cognia-source": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./types": {
      "cognia-source": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

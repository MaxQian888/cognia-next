{
  "name": "@cognia/agent-orchestration",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia multi-agent orchestration core (ADR-0217): durable Agent Team run records, the TeamRunStore port with a reference in-memory store and its conformance contract, replay-safety and attempt-fencing rules, fair scheduling and the teammate executor port. No host code.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/build/pack-test-agent-package.mjs agent-orchestration"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

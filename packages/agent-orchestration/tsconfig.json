{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "incremental": false,
    "ignoreDeprecations": "6.0",
    // No sibling dependencies. These `paths` replace the root's, so an `@/`
    // or `@cognia/*` import fails to compile.
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

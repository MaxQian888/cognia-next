{
  "name": "@cognia/rag",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia RAG toolkit: hybrid search (BM25 + vector), reranking, contextual retrieval, query expansion, CJK tokenization, context management, and the unified RAG runtime.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-embedding": "workspace:*",
    "@cognia/redact": "workspace:*",
    "@cognia/vector": "workspace:*"
  },
  "peerDependencies": {
    "ai": "*",
    "@ai-sdk/openai": "*",
    "zod": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

{
  "name": "@cognia/provider-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia AI provider runtime: discovery, protocol adapters, health/pricing, local providers, AI SDK client factory.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/*": {
      "cognia-source": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    },
    "./core/*": {
      "cognia-source": "./src/core/*.ts",
      "default": "./src/core/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-types": "workspace:*"
  },
  "peerDependencies": {
    "ai": "*",
    "@ai-sdk/anthropic": "*",
    "@ai-sdk/openai": "*",
    "@ai-sdk/google": "*",
    "@ai-sdk/mistral": "*",
    "@ai-sdk/cohere": "*",
    "zod": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

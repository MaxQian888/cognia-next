{
  "name": "@cognia/provider-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia AI provider runtime: discovery, protocol adapters, health/pricing, local providers, AI SDK client factory.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/*": {
      "cognia-source": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    },
    "./core/*": {
      "cognia-source": "./src/core/*.ts",
      "default": "./src/core/*.ts"
    },
    "./operations/*": {
      "cognia-source": "./src/operations/*.ts",
      "default": "./src/operations/*.ts"
    }
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-types": "workspace:*",
    "nanoid": "^6.0.2"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": "*",
    "@ai-sdk/anthropic": "*",
    "@ai-sdk/azure": "^4.0.92",
    "@ai-sdk/cohere": "*",
    "@ai-sdk/google": "*",
    "@ai-sdk/mistral": "*",
    "@ai-sdk/openai": "*",
    "@tauri-apps/api": "^2.12.1",
    "ai": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@ai-sdk/azure": "4.0.92",
    "@tauri-apps/api": "^2.12.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  }
}

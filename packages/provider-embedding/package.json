{
  "name": "@cognia/provider-embedding",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia embedding providers: dense/sparse/multimodal/late-interaction embeddings, chunking, embedding catalog.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-core": "workspace:*",
    "@cognia/provider-types": "workspace:*"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": "*",
    "@ai-sdk/cohere": "^4.0.55",
    "@ai-sdk/google": "^4.0.88",
    "@ai-sdk/mistral": "^4.0.57",
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/provider": "*",
    "ai": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@ai-sdk/cohere": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4"
  }
}

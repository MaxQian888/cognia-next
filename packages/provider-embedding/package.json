{
  "name": "@cognia/provider-embedding",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia embedding providers: dense/sparse/multimodal/late-interaction embeddings, chunking, embedding catalog.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-types": "workspace:*",
    "@cognia/provider-core": "workspace:*"
  },
  "peerDependencies": {
    "ai": "*",
    "@ai-sdk/amazon-bedrock": "*",
    "@ai-sdk/provider": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

{
  "name": "@cognia/agent-a2a",
  "version": "0.0.0",
  "private": true,
  "description": "A2A integration for Cognia agents (ADR-0217): the a2a protocol adapter (Agent Card discovery, JSON-RPC message/send and message/stream over SSE, task cancel) over the host's fetch and outbound gate, and its manifest.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/build/pack-test-agent-package.mjs agent-a2a"
  },
  "dependencies": {
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/agent-runtime-kit": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@cognia/redact": "workspace:*"
  }
}

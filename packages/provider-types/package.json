{
  "name": "@cognia/provider-types",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia AI provider type definitions and catalog metadata (framework-agnostic).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

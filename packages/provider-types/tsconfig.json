{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // tsup's .d.ts emit runs a standalone tsc that can't share the root's
    // incremental build-info file, and rollup-plugin-dts injects a baseUrl that
    // TS 6.x flags as deprecated. Neither affects the app's typecheck (separate
    // tsconfig); scope the overrides to this package's build.
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}

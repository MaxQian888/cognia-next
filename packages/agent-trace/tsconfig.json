{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../../*"],
      "@cognia/provider-types": ["../provider-types/src/index.ts"],
      "@cognia/provider-types/*": ["../provider-types/src/*"],
      "@cognia/provider-core": ["../provider-core/src/index.ts"],
      "@cognia/provider-core/*": ["../provider-core/src/*"],
      "@cognia/provider-embedding": ["../provider-embedding/src/index.ts"],
      "@cognia/provider-embedding/*": ["../provider-embedding/src/*"],
      "@cognia/provider-routing": ["../provider-routing/src/index.ts"],
      "@cognia/provider-routing/*": ["../provider-routing/src/*"],
      "@cognia/agent-trace": ["./src/index.ts"],
      "@cognia/agent-trace/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}

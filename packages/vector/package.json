{
  "name": "@cognia/vector",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia unified vector store: backend-agnostic IVectorStore interface, embedding adapter, dimension guard, readiness checks, Tauri invoke layer, and credential migration.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-types": "workspace:*",
    "@cognia/provider-embedding": "workspace:*"
  },
  "peerDependencies": {
    "@tauri-apps/api": "*"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

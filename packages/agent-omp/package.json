{
  "name": "@cognia/agent-omp",
  "version": "0.0.0",
  "private": true,
  "description": "Oh-my-pi native RPC integration behind Cognia host ports; independently testable and not registered in the app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_LICENSES"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "pack:test": "node scripts/pack-test.mjs",
    "smoke": "node scripts/process-smoke.mjs"
  },
  "dependencies": {
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/agent-runtime-kit": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

{
  "name": "@cognia/agent-runtime-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared building blocks for Cognia external-agent adapters (ADR-0217): base adapter, JSON-RPC peer, LF frame decoder, content blocks, unsupported-extension errors, orphan reclaim, permission-mode ranking.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/build/pack-test-agent-package.mjs agent-runtime-kit"
  },
  "dependencies": {
    "@cognia/agent-contracts": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

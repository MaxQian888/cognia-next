{
  "name": "@cognia/agent-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia agent contracts (ADR-0217): agent identity, external-agent wire/session/config types, the adapter core with optional capabilities, execution semantics and host ports. No runtime dependencies.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/build/pack-test-agent-package.mjs agent-contracts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

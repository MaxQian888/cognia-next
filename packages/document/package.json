{
  "name": "@cognia/document",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia document parsing layer: folds eleven mainstream formats (PDF, Office, EPUB, HTML, Markdown, RTF, CSV, code, presentation, OpenDocument) into a single ProcessedDocument with text, embeddable text, structured metadata, and parse diagnostics.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-embedding": "workspace:*",
    "@firecrawl/anydoc-wasm": "0.1.9"
  },
  "peerDependencies": {
    "cheerio": "*",
    "jszip": "*",
    "mammoth": "*",
    "pdfjs-dist": "*",
    "xlsx": ">=0.20.2"
  },
  "devDependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}

{
  "name": "@cognia/provider-routing",
  "version": "0.0.0",
  "private": true,
  "description": "Cognia provider routing: selection engine, filters, strategies, model-option source, error classification, session affinity.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cognia-source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "cognia-source": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cognia/provider-types": "workspace:*",
    "@cognia/provider-core": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "@cognia/agent-acp",
  "version": "0.0.0",
  "private": true,
  "description": "ACP integration for Cognia agents (ADR-0217): the Agent Client Protocol client over host-provided process, file, terminal, fetch and WebSocket ports, its wire codec, feature profile, permission-input derivation, ACP Registry v1 client, the per-conversation Devin adapter, manifest and execution semantics.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup",
    "typecheck": "tsc --noEmit",
    "pack:test": "node ../../scripts/build/pack-test-agent-package.mjs agent-acp"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@cognia/agent-contracts": "workspace:*",
    "@cognia/agent-runtime-kit": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@cognia/redact": "workspace:*"
  }
}

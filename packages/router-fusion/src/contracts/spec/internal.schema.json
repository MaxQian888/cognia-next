{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:router-fusion:contracts:1.0.0",
  "title": "Router Fusion implementation contracts",
  "$defs": {
    "MoneyUSD": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,6})?$"
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        }
      },
      "required": ["role", "content"]
    },
    "InputMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        }
      },
      "required": ["role", "content"]
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "$ref": "#/$defs/MoneyUSD"
        },
        "mode": {
          "type": "string",
          "enum": ["strict", "tracked"]
        }
      },
      "required": ["max_cost_usd", "mode"]
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "input_messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputMessage"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_session_version": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": ["auto", "direct", "cascade", "panel", "delegate"]
        },
        "allowed_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["direct", "cascade", "panel", "delegate"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "profile": {
          "type": "string",
          "enum": ["economy", "balanced", "quality"]
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "acceptance_profile_id": {
          "type": "string"
        },
        "allow_degraded": {
          "type": "boolean"
        },
        "delivery": {
          "type": "string",
          "enum": ["verified_buffered"]
        }
      },
      "required": [
        "schema_version",
        "input_messages",
        "mode",
        "allowed_modes",
        "profile",
        "budget",
        "deadline_ms",
        "allow_degraded",
        "delivery"
      ],
      "dependentRequired": {
        "session_id": ["expected_session_version"],
        "expected_session_version": ["session_id"]
      }
    },
    "RunAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_for_input",
            "waiting_for_approval",
            "reconciling",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled",
            "expired"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "session_id",
        "session_version",
        "status",
        "version",
        "created_at"
      ]
    },
    "RoutingFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "goal": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "enum": [
            "text.transform",
            "data.extract",
            "qa.knowledge",
            "research.synthesis",
            "reasoning.solve",
            "code.implement",
            "code.debug",
            "code.review",
            "agent.plan",
            "agent.execute",
            "unknown"
          ]
        },
        "phase": {
          "type": "string",
          "enum": ["intake", "planning", "investigation", "execution", "verification", "review"]
        },
        "language": {
          "type": "string"
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguity": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        },
        "tool_need": {
          "type": "string",
          "enum": ["none", "read_only", "sandbox_write", "external_write", "unknown"]
        },
        "scope": {
          "type": "string",
          "enum": ["single_item", "single_file", "multi_file", "cross_system", "unknown"]
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "verification_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "feature_version": {
          "type": "string"
        },
        "context_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "goal",
        "task",
        "phase",
        "language",
        "missing_information",
        "ambiguity",
        "tool_need",
        "scope",
        "failed_attempts",
        "verification_kinds",
        "source_revision",
        "feature_version",
        "context_truncated"
      ]
    },
    "QualityEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "p_pass": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "group_pass_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": ["rule", "eval", "model"]
        },
        "support_count": {
          "type": "integer",
          "minimum": 0
        },
        "in_distribution": {
          "type": "boolean"
        },
        "predictor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "p_pass",
        "group_pass_rate",
        "source",
        "support_count",
        "in_distribution",
        "predictor_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": ["rule", "eval"]
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "p_pass": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "model"
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "p_pass": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "predictor_version": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "CandidateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityEstimate"
        },
        "expected_cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserve_cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimated_p95_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "action_id",
        "eligible",
        "exclusion_reasons",
        "quality",
        "expected_cost_microusd",
        "reserve_cost_microusd",
        "estimated_p95_ms"
      ]
    },
    "RouteDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "selected_action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode_selected": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["direct", "cascade", "panel", "delegate"]
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateAssessment"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_version": {
          "type": "string"
        },
        "registry_version": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "classifier_version": {
          "type": "string"
        },
        "degraded": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "run_id",
        "selected_action_id",
        "mode_selected",
        "candidates",
        "reason_codes",
        "policy_version",
        "registry_version",
        "prompt_version",
        "classifier_version",
        "degraded",
        "created_at"
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["artifact_id", "content_sha256", "locator", "retrieved_at"]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "required": ["claim_id", "text", "evidence_refs"]
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "candidate_id": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "candidate_id",
        "answer",
        "claims",
        "assumptions",
        "open_questions"
      ]
    },
    "Contradiction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "resolution": {
          "type": "string",
          "enum": ["resolved", "unresolved"]
        },
        "summary": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "required": ["topic", "claim_ids", "resolution", "summary", "evidence_refs"]
    },
    "VerificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["artifact_read", "source_check", "compute", "test"]
        },
        "question": {
          "type": "string"
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": ["request_id", "kind", "question", "artifact_ids"]
    },
    "JudgeReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "supported_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contradiction"
          }
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationRequest"
          }
        },
        "ready_to_synthesize": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "supported_claim_ids",
        "rejected_claim_ids",
        "contradictions",
        "missing_requirements",
        "verification_requests",
        "ready_to_synthesize"
      ]
    },
    "Subtask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "goal": {
          "type": "string"
        },
        "base_revision": {
          "type": "string"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tool_policy_id": {
          "type": "string"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "artifact_namespace": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "goal",
        "base_revision",
        "allowed_paths",
        "constraints",
        "acceptance",
        "tool_policy_id",
        "max_steps",
        "artifact_namespace"
      ]
    },
    "WorkerResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "summary": {
          "type": "string"
        },
        "base_revision": {
          "type": "string"
        },
        "result_revision": {
          "type": "string"
        },
        "patch_artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "claimed_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "summary",
        "base_revision",
        "result_revision",
        "patch_artifact_id",
        "claimed_check_ids",
        "open_questions"
      ]
    },
    "VerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_applicable"]
        },
        "summary": {
          "type": "string"
        },
        "executed_by": {
          "type": "string",
          "enum": ["runtime", "model", "human"]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": ["check_id", "kind", "status", "summary", "executed_by", "artifact_refs"]
    },
    "VerificationReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_applicable"]
        },
        "level": {
          "type": "string",
          "enum": ["schema_only", "model_review", "tool_verified", "human_review", "mixed"]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          }
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifier_version": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "status",
        "level",
        "checks",
        "revision",
        "verifier_version",
        "artifact_refs"
      ]
    },
    "BillableItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ordinary_input",
            "cache_read",
            "cache_write_5m",
            "cache_write_1h",
            "output",
            "reasoning_separate",
            "tool",
            "request",
            "other"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "amount_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate_version": {
          "type": "string"
        }
      },
      "required": ["kind", "quantity", "unit", "amount_microusd", "rate_version"]
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_uncached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_included_in_output": {
          "type": "boolean"
        },
        "billable_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BillableItem"
          }
        },
        "cost_status": {
          "type": "string",
          "enum": ["actual", "estimated", "pending"]
        },
        "raw_usage_artifact_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_uncached_tokens",
        "input_cache_read_tokens",
        "input_cache_write_tokens",
        "output_tokens",
        "reasoning_tokens",
        "reasoning_included_in_output",
        "billable_items",
        "cost_status",
        "raw_usage_artifact_id"
      ]
    },
    "BillingSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_cap_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spent_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_step_reservations_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tenant_hold_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": ["actual", "estimated", "pending"]
        },
        "overspend_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "budget_cap_microusd",
        "spent_microusd",

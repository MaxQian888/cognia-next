    "ResumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["input", "approval"]
        },
        "expected_run_version": {
          "type": "integer",
          "minimum": 0
        },
        "input_messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputMessage"
          },
          "minItems": 1
        },
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "type": "string",
          "enum": ["approve", "reject"]
        }
      },
      "required": ["kind", "expected_run_version"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "input"
              }
            }
          },
          "then": {
            "required": ["input_messages"],
            "not": {
              "anyOf": [
                {
                  "required": ["approval_id"]
                },
                {
                  "required": ["decision"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "then": {
            "required": ["approval_id", "decision"],
            "not": {
              "required": ["input_messages"]
            }
          }
        }
      ]
    },

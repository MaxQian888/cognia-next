        "attachment": false,
        "reasoning": false,
        "tool_call": true,
        "temperature": true,
        "release_date": "2025-12-03",
        "last_updated": "2026-07-11",
        "modalities": { "input": ["text"], "output": ["text"] },
        "open_weights": false,
        "limit": { "context": 128000, "output": 8192 },
        "cost": { "input": 0, "output": 0 }
      }
    }
  }

{
  "lynkr": {
    "id": "lynkr",
    "env": ["LYNKR_API_KEY"],
    "npm": "@ai-sdk/openai-compatible",
    "api": "http://127.0.0.1:8081/v1",
    "name": "Lynkr",
    "doc": "https://github.com/Fast-Editor/Lynkr",
    "models": {
      "lynkr-auto": {
        "id": "lynkr-auto",

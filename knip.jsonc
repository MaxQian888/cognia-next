{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/sw.ts",
        "cli/src/cli/entry.ts",
        "components/{ai-elements,ui}/**/*.{ts,tsx}",
        "hooks/builtin/*.mjs",
        "lib/browser-stubs/*.{js,ts}",
        "lib/browser/overlay.injected.js",
        "plugins/*/src/index.{ts,tsx}",
        "plugins/*/*.harness.mjs",
        "plugins/**/tests/fixtures/**/*.{js,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts,mts}",
        "src-tauri/scripts/**/*.{js,mjs,ts}",
      ],
      "project": [
        "{__mocks__,app,cli,components,hooks,i18n,lib,plugins,scripts,src-tauri/scripts,stores,tests,types}/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}",
      ],
      "ignore": [".agents/**"],
      // Loaded from CSS, dynamic imports, or as providers for workspace peer dependencies.
      "ignoreDependencies": [
        "@ai-sdk/react",
        "@hookform/resolvers",
        "@radix-ui/react-slot",
        "@tauri-apps/api",
        "@tauri-apps/plugin-shell",
        "@types/katex",
        "katex",
        "langfuse",
        "mammoth",
        "mermaid",
        "pdfjs-dist",
        "shadcn",
        "tailwindcss",
        "tesseract.js",
        "tw-animate-css",
        "ts-jest",
        "xlsx",
      ],
      // Host toolchains installed outside pnpm and invoked by repository scripts.
      "ignoreBinaries": ["chcp.com", "pwsh", "rg", "rustfmt", "uv"],
      "ignoreIssues": {
        "**/*.generated.{js,ts,tsx}": [
          "files",
          "exports",
          "nsExports",
          "types",
          "nsTypes",
          "enumMembers",
          "namespaceMembers",
          "duplicates",
        ],
      },
    },
    "docs": {},
    "crates/cognia-plugin-template-ts": {
      // The template intentionally predeclares the host libraries available to
      // third-party plugin authors; its starter module need not import all of
      // them before generation.
      "ignoreDependencies": [
        "@types/json-schema",
        "ai",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "dexie",
        "radix-ui",
        "zod",
      ],
    },
    "browser-extension": {
      // WXT discovers entrypoints by directory convention, so without this
      // knip sees every one of them as an unimported file.
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      // Tailwind is consumed by the `@import` in `src/styles/tokens.css`,
      // which knip does not follow into CSS.
      "ignoreDependencies": ["^tailwindcss$"],
    },
    "crates/cognia-plugin-template-vscode-extension": {},
    "mobile": {
      "entry": ["scripts/*.{js,mjs,ts}"],
      "project": ["scripts/*.{js,mjs,ts}"],
      "ignoreDependencies": ["^@capacitor(?:-|/)", "^@capgo/", "^capacitor-"],
    },
    "packages/*": {},
    "packages/plugin-sdk": {
      "entry": ["scripts/import-code-128-contribution-schemas.mjs", "tsup.author-types.config.ts"],
    },
    "packages/plugin-ui": {
      "entry": ["tsup.author-types.config.ts"],
    },
    "services/share-server/worker": {
      "ignoreDependencies": ["^cloudflare$"],
    },
    "services/workspace-runtime": {},
    "sidecar": {
      // Packaged by Tauri and launched from the Rust bridge.
      "entry": ["a2ui-mcp.mjs"],
      "ignoreDependencies": ["@vscode/ripgrep"],
      "ignoreIssues": {
        "dispatch/protocol-adapters/provider-protocol.d.mts": ["files"],
      },
    },
    "sidecar/vscode-ext-host": {
      "entry": ["tests/fixtures/**/*.{js,mjs,ts}"],
      "ignoreDependencies": ["^vscode$", "vscode-languageclient"],
    },
    "sidecar/codeserver-agent-ext": {
      "entry": ["build.mjs", "src/{extension,proxy-extension}.mjs"],
    },
    "sidecar/webclone": {},
  },
}

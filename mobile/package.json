{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor 8 mobile shell wrapping the Tauri-shared Next.js static export at ../out",
  "scripts": {
    "sync": "cap sync",
    "sync:ios": "node scripts/configure-ios-project.mjs && cap sync ios",
    "sync:android": "cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "add:ios": "node scripts/add-ios.mjs",
    "add:android": "cap add android",
    "patch:ios": "node scripts/configure-ios-project.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.6.4",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "capacitor-native-settings": "^8.2.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "capacitor-voice-recorder": "^7.0.6",
    "capacitor-zeroconf": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}

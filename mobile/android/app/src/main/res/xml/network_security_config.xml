<?xml version="1.0" encoding="utf-8"?>
<!--
    OS trust for the companion API. Stock CapacitorHttp does not implement
    serverTrustMode; unknown JS fields cannot change certificate validation.
    The optional build-time pin-set further restricts an already trusted chain.
    Runtime pairing pins require an attested native implementation; pinned-fetch
    refuses that route when the implementation is absent.
-->
<network-security-config>
    <!-- Explicit user/system CA trust only for these named endpoints. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">cognia-companion.local</domain>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
        <!-- INJECT_PIN_SET — runtime fingerprint injection target.
             `mobile/scripts/inject-server-fingerprint.mjs` rewrites this
             comment with a `<pin-set>` element when COGNIA_PIN_FINGERPRINT
             (or a fingerprint file) is present at sync time. Production
             release builds are expected to pin; dev/debug builds leave
             this comment in place. -->
    </domain-config>

    <!-- Other hosts, including LAN IP addresses, use system trust below.
         Self-signed certificates are not accepted by a per-request override. -->

    <!-- Production builds: default-deny cleartext. Debug build's manifest
         (mobile/android/app/src/debug/AndroidManifest.xml) overrides
         usesCleartextTraffic="true" so dev-server HTTP loads still work. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY Network Security Config (Wave 4.x emulator support).

    Goals:
      1. Keep CapacitorHttp's per-request `serverTrustMode: "self-signed"` /
         `"pinned"` policy as the source of truth for HTTPS traffic.
      2. Explicitly trust the Android emulator host gateway (10.0.2.2 and
         the loopback alias 127.0.0.1) so `adb reverse` based pairing on a
         Pixel 7 API 34 AVD can complete without manifest-level rejections.
      3. Permit cleartext on those development hosts so a dev override port
         (7891 / 7900 / 8443) or a non-HTTPS dev build still goes through.

    Production builds use the strict overlay in
    `mobile/android/app/src/main/res/xml/network_security_config.xml` and
    do NOT inherit anything from this file.
-->
<network-security-config>
    <!-- Emulator host gateway. `adb reverse tcp:7890 tcp:7890` makes the
         desktop companion reachable as 10.0.2.2:7890 from the AVD. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>

# Public env vars — exposed to browser, MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="React Quick Starter"
NEXT_PUBLIC_API_URL=https://api.example.com

# WebRTC signaling rendezvous endpoint (ADR-0021). Inlined at build time into
# every shell (browser/Tauri/Capacitor) and the Rust desktop peer (option_env!).
# Defaults to wss://signaling.cognia.cn/v1/signaling when unset. Keep it in sync
# with the Worker's custom-domain route in services/signaling-server/worker/wrangler.toml.
# NEXT_PUBLIC_SIGNALING_URL=wss://signaling.cognia.cn/v1/signaling

# ADR-0059 C1 - self-host web client: bake your cognia-server URL into the
# static export so the browser pairs against it (leave unset for BYOK web).
# NEXT_PUBLIC_COGNIA_SERVER_URL=https://cognia.example.com

# Public share-link service endpoint (ADR-0037). Inlined at build time; the
# per-install override lives in AppSettings.shareUrl (Settings → Share links).
# Defaults to https://share.cognia.cn when unset. Keep it in sync with the
# Worker's custom-domain route in services/share-server/worker/wrangler.toml.
# NEXT_PUBLIC_SHARE_URL=https://share.cognia.cn

# Local-account password gate. Dev builds (`pnpm dev` / `pnpm tauri dev`) unlock
# the active account at boot so the gate never prompts — shipped builds always
# prompt, the relaxation is compiled out. Set this to 1 when you need to exercise
# the real unlock flow (or the idle auto-lock) from a dev build.
# NEXT_PUBLIC_ACCOUNT_GATE=1

# Issue-tracker base URL for the error page's "Report issue" button. When set,
# the route-level error boundaries show a button that opens a pre-filled issue
# (…/issues/new?title=…&body=…) with the crash report. Unset → button hidden.
# NEXT_PUBLIC_ISSUE_REPORT_URL=https://github.com/your-org/your-repo

# Managed PostHog project (ADR-0074). Both must be set for the "managed"
# destination to appear in Settings -> Observability -> PostHog; without them
# only a bring-your-own project can be configured. The token is the PUBLIC
# project ingestion key (`phc_...`) - a personal API key is rejected.
# Product analytics and AI observability each stay behind their own opt-in
# switch, so setting these does not start any export on its own.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# --- Headless brain (`cognia-agent serve`) telemetry -------------------------
# These are read at runtime by the brain process, not inlined at build time.
# Every remote destination below is additionally gated on the account's own
# behavior-telemetry consent (master switch + "Export remotely"); setting them
# configures a destination, it does not grant permission to use it.
#
# OTLP behavior-event logs. The signal-specific variable wins; the base one
# gets `/v1/logs` appended.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://collector.example/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=Bearer%20token
#
# PostHog product analytics. `NEXT_PUBLIC_POSTHOG_*` above is accepted as a
# fallback, so a deployment carrying the managed project needs these only to
# point the brain somewhere else.
# COGNIA_POSTHOG_HOST=https://us.i.posthog.com
# COGNIA_POSTHOG_PROJECT_TOKEN=phc_your_project_token
#
# REQUIRED for PostHog on the brain, and only there. The brain's localStorage
# is an in-memory shim, so an auto-generated id would be new on every restart
# and PostHog would count one install as a fresh person per process. Pin any
# stable opaque value (a UUID); never an account id, email, or hostname.
# Without it the PostHog destination stays off and the brain logs why.
# COGNIA_OBSERVABILITY_INSTALLATION_ID=00000000-0000-4000-8000-000000000000

# Private env vars (server-only, NOT exposed to browser).
# Add server-only secrets below this line as your project grows.
# DATABASE_URL=
# API_SECRET_KEY=

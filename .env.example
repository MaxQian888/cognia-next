# Public env vars — exposed to browser, MUST start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME="React Quick Starter"
NEXT_PUBLIC_API_URL=https://api.example.com

# WebRTC signaling rendezvous endpoint (ADR-0021). Inlined at build time into
# every shell (browser/Tauri/Capacitor) and the Rust desktop peer (option_env!).
# Defaults to wss://signaling.cognia.cn/v1/signaling when unset. Keep it in sync
# with the Worker's custom-domain route in services/signaling-server/worker/wrangler.toml.
# NEXT_PUBLIC_SIGNALING_URL=wss://signaling.cognia.cn/v1/signaling

# Issue-tracker base URL for the error page's "Report issue" button. When set,
# the route-level error boundaries show a button that opens a pre-filled issue
# (…/issues/new?title=…&body=…) with the crash report. Unset → button hidden.
# NEXT_PUBLIC_ISSUE_REPORT_URL=https://github.com/your-org/your-repo

# Private env vars (server-only, NOT exposed to browser).
# Add server-only secrets below this line as your project grows.
# DATABASE_URL=
# API_SECRET_KEY=

{
  "$comment": "Single source for the live session-control surface (`methods`) and the session-level SDK functions (`sessionApi`). See scripts/gates/check-agent-control-methods.mjs.",
  "schemaVersion": 1,
  "methods": [
    {
      "name": "accountInfo",
      "kind": "sdk",
      "exposure": "control",
      "capability": "session.manage",
      "args": []
    },
    {
      "name": "applyFlagSettings",
      "kind": "sdk",
      "exposure": "control",
      "capability": "session.manage",
      "args": ["settings"]
    },
    {
      "name": "backgroundTasks",
      "kind": "sdk",
      "exposure": "control",
      "capability": "tasks.background",
      "args": ["toolUseId"]
    },
    {
      "name": "close",
      "kind": "sdk",
      "exposure": "dedicated-command",
      "capability": "streaming",
      "command": "agent_close_session"
    },
    {
      "name": "getContextUsage",
      "kind": "sdk",
      "exposure": "control",
      "capability": "context-management",
      "args": []
    },
    {
      "name": "initializationResult",
      "kind": "sdk",
      "exposure": "control",
      "capability": "session.manage",
      "args": []
    },
    {
      "name": "interrupt",
      "kind": "sdk",
      "exposure": "dedicated-command",
      "capability": "permissions.interrupt-resume",
      "command": "agent_interrupt"
    },
    {
      "name": "mcpServerStatus",
      "kind": "sdk",
      "exposure": "control",
      "capability": "mcp",
      "args": []
    },
    {
      "name": "readFile",
      "kind": "sdk",
      "exposure": "control",
      "capability": "checkpoint",
      "args": ["path", "options"]
    },
    {
      "name": "reconnectMcpServer",
      "kind": "sdk",
      "exposure": "control",
      "capability": "mcp",
      "args": ["serverName"]
    },
    {
      "name": "reinitialize",
      "kind": "sdk",
      "exposure": "control",
      "capability": "session.manage",
      "args": []
    },
    {
      "name": "reloadPlugins",
      "kind": "sdk",
      "exposure": "control",
      "capability": "plugins.native",
      "args": []
    },
    {
      "name": "reloadSkills",
      "kind": "sdk",
      "exposure": "control",
      "capability": "skills.native",
      "args": []
    },
    {
      "name": "rewindFiles",
      "kind": "sdk",
      "exposure": "control",
      "capability": "checkpoint",
      "args": ["userMessageId", "options"]
    },
    {
      "name": "seedReadState",
      "kind": "sdk",
      "exposure": "control",
      "capability": "checkpoint",
      "args": ["path", "mtime"]
    },
    {
      "name": "setMaxThinkingTokens",
      "kind": "sdk",
      "exposure": "control",
      "capability": "thinking",
      "args": ["maxThinkingTokens", "thinkingDisplay"],
      "note": "deprecated in 0.3.220 in favour of the `thinking` query() option; still the only mid-session lever"
    },
    {
      "name": "setMcpPermissionModeOverride",
      "kind": "sdk",
      "exposure": "control",
      "capability": "mcp.dynamic",
      "args": ["serverName", "mode"]
    },
    {
      "name": "setMcpServers",
      "kind": "sdk",
      "exposure": "control",
      "capability": "mcp.dynamic",
      "args": ["servers"]
    },
    {
      "name": "setModel",
      "kind": "sdk",
      "exposure": "control",
      "capability": "set-model",
      "args": ["model"]
    },
    {
      "name": "setPermissionMode",
      "kind": "sdk",
      "exposure": "control",
      "capability": "permissions.set-mode",
      "args": ["mode"]
    },
    {
      "name": "steer",
      "kind": "host",
      "exposure": "control",
      "capability": "steer",
      "args": ["prompt", "priority"],
      "note": "intercepted in agent-host.mjs routeSteer(); pushes a user turn onto the input stream"
    },
    {
      "name": "stopTask",
      "kind": "sdk",
      "exposure": "control",
      "capability": "tasks.background",
      "args": ["taskId"]
    },
    {
      "name": "streamInput",
      "kind": "sdk",
      "exposure": "not-exposed",
      "capability": "session.multi-turn",
      "reason": "a control frame is JSON and this takes an AsyncIterable. Multi-turn input reaches the same place through `agent_send` -> pushUserMessage, which is the async iterable query() was handed."
    },
    {
      "name": "supportedAgents",
      "kind": "sdk",
      "exposure": "control",
      "capability": "subagents.manage",
      "args": []
    },
    {
      "name": "supportedCommands",
      "kind": "sdk",
      "exposure": "control",
      "capability": "commands.dynamic",
      "args": []
    },
    {
      "name": "supportedModels",
      "kind": "sdk",
      "exposure": "control",
      "capability": "set-model",
      "args": []
    },
    {
      "name": "toggleMcpServer",
      "kind": "sdk",
      "exposure": "control",
      "capability": "mcp",
      "args": ["serverName", "enabled"]
    },
    {
      "name": "usage_EXPERIMENTAL_MAY_CHANGE_DO_NOT_RELY_ON_THIS_API_YET",
      "kind": "sdk",
      "exposure": "not-exposed",
      "capability": "observability.child",
      "reason": "the SDK marks it EXPERIMENTAL and says the method name itself will change when it stabilises. Exposing it would put that rename on our IPC surface, where it becomes a breaking change for every host."
    }
  ],
  "sessionApi": [
    {
      "name": "listSessions",
      "capability": "session.manage",
      "mutates": false,
      "args": [],
      "store": true
    },
    {
      "name": "getSessionInfo",
      "capability": "session.manage",
      "mutates": false,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "getSessionMessages",
      "capability": "session.manage",
      "mutates": false,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "listSubagents",
      "capability": "subagents.manage",
      "mutates": false,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "getSubagentMessages",
      "capability": "subagents.manage",
      "mutates": false,
      "args": ["sessionId", "agentId"],
      "store": true
    },
    {
      "name": "renameSession",
      "capability": "session.manage",
      "mutates": true,
      "args": ["sessionId", "title"],
      "store": true
    },
    {
      "name": "tagSession",
      "capability": "session.manage",
      "mutates": true,
      "args": ["sessionId", "tag"],
      "store": true
    },
    {
      "name": "deleteSession",
      "capability": "session.manage",
      "mutates": true,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "forkSession",
      "capability": "session.manage",
      "mutates": true,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "importSessionToStore",
      "capability": "session.store",
      "mutates": true,
      "args": ["sessionId"],
      "store": true
    },
    {
      "name": "resolveSettings",
      "capability": "session.manage",
      "mutates": false,
      "args": [],
      "store": false
    }
  ]
}

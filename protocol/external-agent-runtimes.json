{
  "version": 1,
  "description": "Canonical external-Agent runtime catalog (ADR-0090 lifecycle plane). The install-side twin of protocol/external-agent-security-policy.json: that file says what Cognia is willing to LAUNCH, this one says what Cognia is willing to INSTALL, CERTIFY and UPDATE. TypeScript consumes it directly through lib/ai/agent/external/runtime-catalog.ts; `pnpm audit:external-agent-runtimes` enforces preset coverage, exact pinning, lock/integrity presence, launch-allowlist parity and waiver accounting.",
  "notes": {
    "ownership": "`managed` = Cognia installed it into a root it may also remove. `system` = the user installed it; Cognia discovers, certifies and launches it but NEVER deletes it. `remote` = nothing local; reached over the network.",
    "certification": "A runtime with no `supportedRange` is uncertified BY POLICY, not by accident: any parseable version resolves to `supported-uncertified` and needs one explicit consent bound to executable identity + version. Absence of certification data must never resolve to a silent pass, which is what shipping these presets without a catalog did.",
    "distributions": "An empty `distributions` array means no managed distribution is approved for this host yet. It is never a licence to fall back to an unpinned install -- a runtime that still launches through a resolving package runner must be accounted for in `unpinnedLaunchWaivers`."
  },
  "unpinnedLaunchWaivers": {
    "note": "Presets that still launch through a network-resolving package runner (`npx -y <pkg>`), which re-resolves the package on every start and can change under the user without consent. Each entry is a KNOWN governance hole, not an approved pattern. An entry may only be removed by adding a fully pinned distribution (exact version + approved frozen lock + integrity); the list may only shrink. `pnpm audit:external-agent-runtimes` fails on any unpinned launch that is not listed here.",
    "runtimes": {
      "codex-acp": "Zed's Codex ACP shim. No vetted lock asset has been curated for a pinned version yet; the preset keeps `npx -y @zed-industries/codex-acp` until one is.",
      "gemini-cli": "Google's Gemini CLI. Ships no Cognia-vetted pinned distribution yet; keeps `npx -y @google/gemini-cli --acp`.",
      "qwen-code": "Qwen Code CLI. Ships no Cognia-vetted pinned distribution yet; keeps `npx -y @qwen-code/qwen-code --acp`."
    }
  },
  "runtimes": [

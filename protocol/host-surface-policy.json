{
  "$comment": "Multi-tenant Host surface policy (docs/plans/2026-10-20-multi-user-organizations-permissions-and-rollout.md §8). Maps every CommandDescriptor capability in protocol/companion-commands.json to the collaboration action a tenant principal must hold before the Host dispatches the command. A test fails when the manifest gains a capability this file does not classify; an unclassified capability is denied in multi-tenant mode. Single-user mode never consults this file. Actions come from protocol/collab-capabilities-v1.json.",
  "schemaVersion": 1,
  "classes": {
    "client": "Runs on the client, never on the Host; not gated here.",
    "operator-only": "Never served to a tenant principal in multi-tenant mode.",
    "org-action": "Requires the named org-scope action for the tenant org.",
    "workspace-action": "Requires the named workspace-scope action in the workspace the Host resolves for the target (never a renderer-supplied id). When the Host cannot resolve a workspace, the fallback org action applies.",
    "sandboxed-execution": "Requires execution.request in the resolved workspace AND a sandbox placement; never a host process."
  },
  "capabilities": {
    "client.local": { "class": "client" },
    "client.read": { "class": "client" },
    "client.write": { "class": "client" },
    "service.internal": { "class": "operator-only" },
    "host.admin": { "class": "org-action", "action": "host.global-surfaces" },
    "host.execute": { "class": "org-action", "action": "host.global-surfaces" },
    "host.observe": {
      "class": "workspace-action",
      "action": "workspace.read",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "performance.observe": { "class": "org-action", "action": "host.global-surfaces" },
    "performance.traces": { "class": "org-action", "action": "host.global-surfaces" },
    "performance.capture": { "class": "org-action", "action": "host.global-surfaces" },
    "scheduler.manage": { "class": "org-action", "action": "host.global-surfaces" },
    "workspace.read": {
      "class": "workspace-action",
      "action": "workspace.read",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "workspace.write": {
      "class": "workspace-action",
      "action": "workspace.write",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "git.write": {
      "class": "workspace-action",
      "action": "host.workspace-surfaces",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "process.spawn": {
      "class": "workspace-action",
      "action": "host.workspace-surfaces",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "terminal.open": {
      "class": "workspace-action",
      "action": "host.workspace-surfaces",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "ssh.files": {
      "class": "workspace-action",
      "action": "host.workspace-surfaces",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "secret.manage": {
      "class": "workspace-action",
      "action": "credential.manage",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "agent.run": {
      "class": "sandboxed-execution",
      "action": "execution.request",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "workflow.run": {
      "class": "sandboxed-execution",
      "action": "execution.request",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "browser.submit": {
      "class": "workspace-action",
      "action": "execution.request",
      "fallbackOrgAction": "host.global-surfaces"
    },
    "browser.read-own": {
      "class": "workspace-action",
      "action": "workspace.read",
      "fallbackOrgAction": "host.global-surfaces"
    }
  }
}

{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // Rust entries need the CodeLLDB extension (vadimcn.vscode-lldb). Tasks named
  // in preLaunchTask / postDebugTask live in .vscode/tasks.json.
  "version": "0.2.0",
  "configurations": [
    // ─── Next.js main app (port 3000) ───────────────────────────────────────
    {
      // `pnpm dev` runs next through cross-env, which REPLACES NODE_OPTIONS and
      // drops js-debug's bootloader, so breakpoints never bind. Launch next
      // directly instead. Without a --max-old-space-size in NODE_OPTIONS, next
      // dev sizes the server heap to 50% of RAM on its own. `ui:prepare` runs
      // the same `predev` asset staging `pnpm dev` would.
      "name": "Next.js: debug server-side",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3000"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:prepare",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "1-next", "order": 1 }
    },
    {
      // Turbopack emits absolute file:// sources, so no sourceMapPathOverrides.
      "name": "Next.js: debug client-side (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ui:dev-if-needed",
      "postDebugTask": "ui:stop",
      "presentation": { "group": "1-next", "order": 2 }
    },
    {
      "name": "Next.js: debug client-side (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ui:dev-if-needed",
      "postDebugTask": "ui:stop",
      "presentation": { "group": "1-next", "order": 3 }
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3000"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:prepare",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      },
      "presentation": { "group": "1-next", "order": 4 }
    },
    {
      // For a server you started yourself with `pnpm dev --inspect`: next
      // forks its dev server with --inspect on the default port 9229.
      // `restart` re-attaches after next restarts the server (config edits).
      "name": "Next.js: attach to `pnpm dev --inspect`",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "1-next", "order": 5 }
    },

    // ─── Tauri desktop shell ───────────────────────────────────────────────
    {
      // sidecar/README.md refers to this entry by name.
      "name": "Tauri Dev (with sidecar logs)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm tauri:dev",
      "env": {
        "COGNIA_SIDECAR_VERBOSE": "1"
      },
      "presentation": { "group": "2-tauri", "order": 1 }
    },
    {
      // Mirrors `pnpm tauri:dev`: default features (ocr-paddle) so the build
      // shares artifacts with it, and the same empty `bundle.resources`
      // TAURI_CONFIG as scripts/dev/tauri.mjs (it must stay byte-identical, or
      // the ~2.9 GB sidecar resource copy re-runs on every switch). The dev
      // profile keeps line tables only: breakpoints and stepping work, locals
      // do not. Use the dev-full entry below when you need variables.
      "name": "Tauri: LLDB debug (dev profile)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=${workspaceFolder}/src-tauri/Cargo.toml",
          "--bin",
          "cognia-next"
        ],
        "env": {
          "TAURI_CONFIG": "{\"bundle\":{\"resources\":[]}}"
        },
        "filter": { "name": "cognia-next", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}/src-tauri",
      "env": { "RUST_BACKTRACE": "1" },
      "sourceLanguages": ["rust"],
      // Cargo's runner (.cargo/config.toml) signs cognia-next with the stable
      // dev identity so the login keychain stops re-prompting; a debugger launch
      // bypasses the runner, so sign here before LLDB loads the binary. The shim
      // is a pass-through on machines without the identity.
      "osx": {
        "initCommands": [
          "platform shell \"${workspaceFolder}/src-tauri/scripts/dev-codesign.sh\" \"${workspaceFolder}/target/debug/cognia-next\" /usr/bin/true"
        ]
      },
      // beforeDevCommand's native prerequisites, then the dev server on :3000.
      "preLaunchTask": "tauri:debug-dev",
      "postDebugTask": "ui:stop",
      "presentation": { "group": "2-tauri", "order": 2 }
    },
    {
      // Same as above on the opt-in `dev-full` profile (Cargo.toml): full
      // DWARF, so LLDB shows locals and Rust types. The first build is a full
      // rebuild into target/dev-full.
      "name": "Tauri: LLDB debug (dev-full, locals)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=${workspaceFolder}/src-tauri/Cargo.toml",
          "--bin",
          "cognia-next",
          "--profile",
          "dev-full"
        ],
        "env": {
          "TAURI_CONFIG": "{\"bundle\":{\"resources\":[]}}"
        },
        "filter": { "name": "cognia-next", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}/src-tauri",
      "env": { "RUST_BACKTRACE": "1" },
      "sourceLanguages": ["rust"],
      "osx": {
        "initCommands": [
          "platform shell \"${workspaceFolder}/src-tauri/scripts/dev-codesign.sh\" \"${workspaceFolder}/target/dev-full/cognia-next\" /usr/bin/true"
        ]
      },
      "preLaunchTask": "tauri:debug-dev",
      "postDebugTask": "ui:stop",
      "presentation": { "group": "2-tauri", "order": 3 }
    },
    {
      // `tauri build` enables `tauri/custom-protocol`, which embeds out/ instead
      // of loading devUrl; a bare cargo release build must pass it itself. The
      // release profile sets `strip = true`, which leaves LLDB nothing to break
      // on, so this build keeps symbols (and therefore rebuilds separately from
      // `tauri build`). `tauri:prepare-build` runs the full beforeBuildCommand.
      "name": "Tauri Production Debug",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=${workspaceFolder}/src-tauri/Cargo.toml",
          "--bin",
          "cognia-next",
          "--features",
          "tauri/custom-protocol"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "false"
        },
        "filter": { "name": "cognia-next", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}/src-tauri",
      "env": { "RUST_BACKTRACE": "1" },
      "sourceLanguages": ["rust"],
      "preLaunchTask": "tauri:prepare-build",
      "presentation": { "group": "2-tauri", "order": 4 }
    },
    {
      // Attach to a process started elsewhere: `pnpm tauri:dev` (cognia-next),
      // `pnpm dev:headless` (cognia-server), or a native helper. On the dev
      // profile you get line tables only (no locals).
      "name": "Rust: attach to running process",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": ["rust"],
      "presentation": { "group": "2-tauri", "order": 5 }
    },
    {
      // One crate's in-file `#[cfg(test)]` modules. `cognia-next` is the
      // src-tauri package (its lib target is `app_lib`); any workspace crate
      // under crates/ works too. An empty filter runs every test in the binary.
      // No artifact filter: `--no-run --lib` yields exactly one executable, and
      // app_lib's target kind is `rlib`, which a `"kind": "lib"` filter rejects.
      "name": "Rust: debug crate unit tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "-p", "${input:rustPackage}"],
        "env": {
          "TAURI_CONFIG": "{\"bundle\":{\"resources\":[]}}"
        }
      },
      "args": ["${input:rustTestFilter}", "--nocapture", "--test-threads=1"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" },
      "sourceLanguages": ["rust"],
      "presentation": { "group": "2-tauri", "order": 6 }
    },

    // ─── Headless Host (renderer-free) ─────────────────────────────────────
    {
      // cognia-server + Brain + agent sidecars on https://127.0.0.1:27890.
      // Builds the native hosts first; to re-run with flags, type them in the
      // terminal, e.g. `pnpm dev:headless --local-debug --skip-build`.
      "name": "Headless: dev:headless",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:headless",
      "presentation": { "group": "3-headless", "order": 1 }
    },
    {
      // Next.js :3000 + headless Host :27890 + plaintext browser listener
      // :27891 + workspace runtime :27910, with the checkout as the workspace
      // root.
      "name": "Headless: dev:web-headless (browser tab + Host)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:web-headless",
      "presentation": { "group": "3-headless", "order": 2 }
    },

    // ─── Tests ─────────────────────────────────────────────────────────────
    {
      // The path goes first (a variadic flag would swallow it) and
      // --runTestsByPath matches it literally, so exactly one suite runs; the
      // jest config picks the node or jsdom project for it. The long timeout
      // keeps a paused breakpoint from failing the test.
      "name": "Jest: debug current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": [
        "${relativeFile}",
        "--runTestsByPath",
        "--runInBand",
        "--no-coverage",
        "--testTimeout=3600000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "4-tests", "order": 1 }
    },
    {
      // node:test suites outside Jest: sidecar/**, scripts/**, services/**
      // (`*.test.mjs`, and sidecar/pi-extension `*.test.ts` via type stripping).
      "name": "node:test: debug current file",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "--test-concurrency=1"],
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "4-tests", "order": 2 }
    },
    {
      // playwright.config.ts starts `pnpm dev` itself unless PLAYWRIGHT_NO_SERVER=1.
      "name": "Playwright: debug current spec (chromium)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${relativeFile}", "--project=chromium", "--workers=1", "--timeout=0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "4-tests", "order": 3 }
    },

    // ─── CLI, sidecar, sites ───────────────────────────────────────────────
    {
      // Rebuilds cli/dist/cognia-agent.mjs with the production esbuild pipeline
      // and runs it. The bundle has no source maps: set breakpoints in
      // cli/dist, not cli/src.
      "name": "CLI: cognia-agent (cli:dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm cli:dev",
      "presentation": { "group": "5-tools", "order": 1 }
    },
    {
      // One real round-trip. Exits 2 when no provider credential is in the
      // environment, 1 on an error frame, 3 on the deadline.
      "name": "Sidecar: smoke round-trip",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/sidecar/claude-host.mjs",
      "args": ["--smoke"],
      "cwd": "${workspaceFolder}",
      "env": { "COGNIA_SIDECAR_VERBOSE": "1" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "5-tools", "order": 2 }
    },
    {
      "name": "Docs site: dev server (:3001)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm docs:dev",
      "presentation": { "group": "5-tools", "order": 3 }
    },
    {
      // web:dev runs web's predev (build-evidence) before next dev.
      "name": "Marketing site: dev server (:3002)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm web:dev",
      "presentation": { "group": "5-tools", "order": 4 }
    }
  ],
  "inputs": [
    {
      "id": "rustPackage",
      "type": "promptString",
      "description": "Cargo package whose lib unit tests to debug (e.g. cognia-next, cognia-git, cognia-terminal)",
      "default": "cognia-next"
    },
    {
      "id": "rustTestFilter",
      "type": "promptString",
      "description": "libtest name filter (empty runs every test in the binary)",
      "default": ""
    }
  ]
}

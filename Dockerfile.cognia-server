# syntax=docker/dockerfile:1.12
## cognia-server — headless Cognia container (ADR-0059 W6).
##
## Stages:
##   chef → planner → deps        cargo-chef: the tauri/wasmtime dependency
##                                cook is the expensive, highly-cacheable layer
##                                (invalidated only by manifest/lock changes).
##   builder | check              full release build vs. codegen-free
##                                `cargo check` (the PR CI target).
##   brain-builder                Node stage bundling the brain (cognia-agent
##                                CLI layout) + sidecar via
##                                scripts/build/build-cli-binary.mjs --layout-only.
##   plugin-node-runtime          pinned Node used only for sandboxed JS plugins.
##   runtime-slim                 binary + brain + sidecar (default image).
##   runtime-full                 + git + preinstalled external agent CLIs
##                                (deploy/runner/install-agents.sh — shared with
##                                the cognia-runner image so versions can't drift).
##
## Usage:
##   docker build -f Dockerfile.cognia-server --target runtime-slim -t cognia-server .
##   docker run --rm -v $HOME/cognia-data:/data -p 27890:27890 cognia-server
##
## The container expects `/data` to be a writable volume so the SQLite store,
## the secret store, and the self-signed TLS cert persist across restarts.
## Headless secret-store note (ADR-0059 W5): set COGNIA_MASTER_KEY or
## COGNIA_MASTER_KEY_FILE — there is no OS keyring in a container.

# ── Rust: cargo-chef base ────────────────────────────────────────────────────
# Base tracks the `rust-toolchain.toml` pin (1.95); matching the base avoids
# downloading a second channel at build time.
FROM rust:1.95-bookworm AS chef
# The official image already contains this exact compiler. Override the
# workspace component list for image builds so cargo does not try to download
# rustfmt/clippy/rust-analyzer while preparing an otherwise compile-only image.
ENV RUSTUP_TOOLCHAIN=1.95.0
# cognia-server links the full app_lib, which (today) compiles the Tauri
# desktop stack wholesale — the standard Tauri v2 Linux build deps are
# required even though no WebView ever opens headless. Slimming this via a
# no-tauri cargo feature on app_lib is a tracked follow-up (ADR-0059).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       pkg-config libssl-dev libglib2.0-dev libgtk-3-dev \
       libwebkit2gtk-4.1-dev libjavascriptcoregtk-4.1-dev libsoup-3.0-dev \
       libayatana-appindicator3-dev librsvg2-dev libpipewire-0.3-dev libclang-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked
# The workspace release profile is tuned for the desktop bundle (thin-LTO and
# one codegen unit). Compiling that full app_lib graph exceeds the memory of a
# standard Linux CI runner even though the headless image does not benefit from
# whole-program desktop optimization. Keep release optimizations while making
# the container build bounded and reproducible on those runners.
ENV CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8 \
    CARGO_BUILD_JOBS=2
WORKDIR /work

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo ./.cargo
COPY src-tauri ./src-tauri
COPY crates ./crates
# Out-of-workspace path dependency of src-tauri (cognia-signaling-core).
COPY services/signaling-server/core ./services/signaling-server/core
RUN cargo chef prepare --recipe-path recipe.json

# The cook layer compiles every dependency of the workspace (tauri, wasmtime,
# axum, …) and is reused as long as Cargo.lock + manifests are unchanged.
FROM chef AS deps
ARG CARGO_REGISTRIES_CRATES_IO_INDEX
ARG CARGO_HTTP_TIMEOUT
ARG CARGO_NET_RETRY
ARG CARGO_NET_GIT_FETCH_WITH_CLI
ARG CARGO_HTTP_MULTIPLEXING
ARG COGNIA_CARGO_REGISTRY_MIRROR=""
COPY rust-toolchain.toml ./
COPY .cargo ./.cargo
# The recipe skeleton still resolves the path dep at cook time.
COPY services/signaling-server/core ./services/signaling-server/core
COPY --from=planner /work/recipe.json .
RUN if [ -n "${COGNIA_CARGO_REGISTRY_MIRROR}" ]; then \
      printf '[source.crates-io]\nreplace-with = "cognia-mirror"\n[source.cognia-mirror]\nregistry = "%s"\n' \
        "${COGNIA_CARGO_REGISTRY_MIRROR}" > /usr/local/cargo/config.toml; \
    fi
RUN cargo chef cook --release --recipe-path recipe.json

# tauri-build validates every plain-file resource path in tauri.conf.json at
# compile time (even for the headless bin). Ship the small sidecar/hook
# scripts it lists; the `**/*` node_modules globs match nothing and pass.
FROM deps AS builder
ARG COGNIA_SERVER_CARGO_FLAGS=""
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgbm-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src-tauri ./src-tauri
COPY crates ./crates
COPY services/signaling-server/core ./services/signaling-server/core
# Out-of-tree include_str! targets (release: browser overlay JS; the spec
# fixtures under cli/ + docs/ are test-cfg but cheap to keep coherent).
COPY lib/browser/overlay.injected.js ./lib/browser/overlay.injected.js
COPY cli/src/serve/fixtures/bridge-frames.json ./cli/src/serve/fixtures/bridge-frames.json
COPY docs/api/mobile-companion-api.openapi.yaml docs/api/headless-service-api.openapi.yaml ./docs/api/
COPY packages/plugin-sdk/contract/catalog.json ./packages/plugin-sdk/contract/catalog.json
COPY packages/logging/src/schemas/observability-event-v1.schema.json ./packages/logging/src/schemas/observability-event-v1.schema.json
COPY protocol/companion-commands.json ./protocol/companion-commands.json
COPY scripts/plugin/node-plugin-host.mjs ./scripts/plugin/node-plugin-host.mjs
COPY sidecar/agent-host.mjs sidecar/claude-host.mjs sidecar/a2ui-mcp.mjs sidecar/cognia-mcp.mjs sidecar/mcp-oauth-helper.mjs sidecar/mcp-stdio-relay.mjs sidecar/package.json ./sidecar/
COPY sidecar/vscode-ext-host/package.json ./sidecar/vscode-ext-host/package.json
COPY sidecar/webclone/package.json ./sidecar/webclone/package.json
COPY hooks/builtin ./hooks/builtin
# tauri-build also requires each resource GLOB to match >=1 file; the real
# trees are desktop bundle content the headless bin never reads.
RUN target_triple=$(rustc -vV | sed -n 's/^host: //p') \
    && mkdir -p src-tauri/binaries sidecar/node_modules/cognia-placeholder sidecar/vscode-ext-host/dist sidecar/vscode-ext-host/node_modules/cognia-placeholder sidecar/webclone/dist sidecar/webclone/node_modules/cognia-placeholder sidecar/codeserver-agent-ext \
    && touch "src-tauri/binaries/cognia-server-${target_triple}" \
    && chmod +x "src-tauri/binaries/cognia-server-${target_triple}" \
    && echo placeholder > sidecar/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/vscode-ext-host/dist/keep.txt \
    && echo placeholder > sidecar/vscode-ext-host/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/webclone/dist/keep.txt \
    && echo placeholder > sidecar/webclone/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/codeserver-agent-ext/cognia-agent-bridge.vsix
# container-exec + k8s-exec (R13): the headless image ships both flavors of
# the container backend, so COGNIA_EXEC_BACKEND=container works at T2
# (Docker socket proxy) and =kubernetes at T3 (runner Pods, in-cluster).
RUN cargo build --release --locked --bin cognia-server \
    --features container-exec,k8s-exec,workspace-runtime-exec,otel-export \
    --config 'profile.release.package.cognia-next.opt-level=0' \
    --config 'profile.release.package.cognia-next.codegen-units=256' \
    --config 'profile.release.package.cognia-next.debug=0' \
    ${COGNIA_SERVER_CARGO_FLAGS}
# Agent-first loopback operator CLI. It is intentionally shipped in the same
# image so service-token issuance and the network peer both stay in-container.
RUN cargo build --release --locked -p cognia-cli --bin cognia
# The Brain layout shells out to this existing automation host. Build it in the
# Rust stage and pass the artifact to brain-builder instead of installing a
# second Rust toolchain in the Node stage.
RUN cargo build --release --locked -p cognia-automation --bin cognia-external-agent-launcher

# PR CI target: type/borrow-check the whole graph without codegen or linking.
FROM deps AS check
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src-tauri ./src-tauri
COPY crates ./crates
COPY services/signaling-server/core ./services/signaling-server/core
# Out-of-tree include_str! targets (release: browser overlay JS; the spec
# fixtures under cli/ + docs/ are test-cfg but cheap to keep coherent).
COPY lib/browser/overlay.injected.js ./lib/browser/overlay.injected.js
COPY cli/src/serve/fixtures/bridge-frames.json ./cli/src/serve/fixtures/bridge-frames.json
COPY docs/api/mobile-companion-api.openapi.yaml docs/api/headless-service-api.openapi.yaml ./docs/api/
COPY packages/plugin-sdk/contract/catalog.json ./packages/plugin-sdk/contract/catalog.json
COPY packages/logging/src/schemas/observability-event-v1.schema.json ./packages/logging/src/schemas/observability-event-v1.schema.json
COPY protocol/companion-commands.json ./protocol/companion-commands.json
COPY scripts/plugin/node-plugin-host.mjs ./scripts/plugin/node-plugin-host.mjs
COPY sidecar/agent-host.mjs sidecar/claude-host.mjs sidecar/a2ui-mcp.mjs sidecar/cognia-mcp.mjs sidecar/mcp-oauth-helper.mjs sidecar/mcp-stdio-relay.mjs sidecar/package.json ./sidecar/
COPY sidecar/vscode-ext-host/package.json ./sidecar/vscode-ext-host/package.json
COPY sidecar/webclone/package.json ./sidecar/webclone/package.json
COPY hooks/builtin ./hooks/builtin
# tauri-build also requires each resource GLOB to match >=1 file; the real
# trees are desktop bundle content the headless bin never reads.
RUN target_triple=$(rustc -vV | sed -n 's/^host: //p') \
    && mkdir -p src-tauri/binaries sidecar/node_modules/cognia-placeholder sidecar/vscode-ext-host/dist sidecar/vscode-ext-host/node_modules/cognia-placeholder sidecar/webclone/dist sidecar/webclone/node_modules/cognia-placeholder sidecar/codeserver-agent-ext \
    && touch "src-tauri/binaries/cognia-server-${target_triple}" \
    && chmod +x "src-tauri/binaries/cognia-server-${target_triple}" \
    && echo placeholder > sidecar/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/vscode-ext-host/dist/keep.txt \
    && echo placeholder > sidecar/vscode-ext-host/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/webclone/dist/keep.txt \
    && echo placeholder > sidecar/webclone/node_modules/cognia-placeholder/keep.txt \
    && echo placeholder > sidecar/codeserver-agent-ext/cognia-agent-bridge.vsix
RUN cargo check --release --locked --bin cognia-server --features container-exec,k8s-exec,workspace-runtime-exec,otel-export
RUN cargo check --release --locked -p cognia-cli --bin cognia

# ── Node: brain (cognia-agent) + sidecar bundle ─────────────────────────────
# Full (non-slim) image: node-gyp needs python3/make/g++ for the sidecar's
# native optional deps (node-pty, better-sqlite3).
FROM node:26-bookworm AS brain-builder
ARG COREPACK_VERSION=0.35.0
ARG PNPM_VERSION=11.18.0
ARG NPM_CONFIG_REGISTRY
ENV HUSKY=0 \
    CI=1
# Node 25+ no longer bundles Corepack. Pin it explicitly so the Brain image
# keeps using the repository's pinned pnpm even when the Node base moves.
RUN npm install --global "corepack@${COREPACK_VERSION}" "pnpm@${PNPM_VERSION}"
WORKDIR /work
# Workspace manifests first so the store-heavy install layer survives source
# edits. pnpm --frozen-lockfile needs every workspace member's package.json
# present; packages/* are small first-party TS libs, copied wholesale (their
# node_modules/dist are stripped by .dockerignore). docs/ + mobile/ only need
# their manifest here — full source arrives with the COPY . . below.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY docs/package.json ./docs/package.json
COPY mobile/package.json ./mobile/package.json
# postinstall needs its guard script (it skips the sidecar steps here — the
# sidecar tree arrives later; its deps install as their own layer below).
COPY scripts/postinstall.mjs ./scripts/postinstall.mjs
# pnpm hashes every patched dependency during a frozen install.
COPY patches ./patches
# pnpm preserves tarball URLs embedded in the frozen lockfile. When a registry
# mirror is explicitly supplied for a constrained CI network, rewrite those
# URLs inside the image as well; the repository lockfile remains untouched.
RUN if [ -n "${NPM_CONFIG_REGISTRY}" ]; then \
      registry="${NPM_CONFIG_REGISTRY%/}"; \
      sed -i "s#https://registry.npmjs.org/#${registry}/#g" pnpm-lock.yaml; \
      pnpm config set registry "${registry}"; \
    fi
RUN --mount=type=cache,id=cognia-pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --fetch-retries=5 --fetch-timeout=300000 --network-concurrency=16
COPY sidecar/package.json sidecar/pnpm-lock.yaml sidecar/pnpm-workspace.yaml ./sidecar/
# A nested pnpm workspace inherits the repository root policy. Hide the root
# config for this isolated install so sidecar/pnpm-workspace.yaml owns the
# native build approvals, then restore it for the remaining root commands.
RUN --mount=type=cache,id=cognia-pnpm-store,target=/root/.local/share/pnpm/store \
    if [ -n "${NPM_CONFIG_REGISTRY}" ]; then \
      registry="${NPM_CONFIG_REGISTRY%/}"; \
      sed -i "s#https://registry.npmjs.org/#${registry}/#g" sidecar/pnpm-lock.yaml; \
      pnpm config set registry "${registry}"; \
    fi \
    && mv pnpm-workspace.yaml pnpm-workspace.root.yaml \
    && pnpm --dir sidecar install --frozen-lockfile --fetch-retries=5 --fetch-timeout=300000 --network-concurrency=16 \
    && mv pnpm-workspace.root.yaml pnpm-workspace.yaml
RUN apt-get update \
    && apt-get install -y --no-install-recommends zip \
    && rm -rf /var/lib/apt/lists/*
# Sources last; the bundle step reaches cli/ + lib/ + the wider @/* TS graph.
COPY . .
COPY --from=builder /work/target/release/cognia-external-agent-launcher ./target/release/cognia-external-agent-launcher
RUN npm --prefix sidecar/webclone ci --no-audit --no-fund \
    && npm --prefix sidecar/webclone run build
RUN npm --prefix sidecar/vscode-ext-host ci --no-audit --no-fund \
    && npm --prefix sidecar/vscode-ext-host run build
RUN pnpm sidecar:codeserver-agent:build
RUN NODE_OPTIONS=--max-old-space-size=8192 node scripts/build/build-cli-binary.mjs --layout-only

# Pinned managed Pro IDE binary. The release digest is selected per BuildKit
# TARGETARCH and verified before extraction; runtime hosts never download or
# self-upgrade this artifact.
FROM node:26-bookworm-slim AS codeserver-preload
ARG TARGETARCH
ARG CODE_SERVER_VERSION=4.128.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && case "$TARGETARCH" in \
         amd64) digest=79ba26bf186e5268a22b7c17b30a5f288a16c37791f0b86c27859e8fef103188 ;; \
         arm64) digest=f8f02c2a81d1a433a4d132716a6f0405f690f6d70dd955942e95e87356db8a10 ;; \
         *) echo "unsupported code-server architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && asset="code-server-${CODE_SERVER_VERSION}-linux-${TARGETARCH}.tar.gz" \
    && curl --fail --location --proto '=https' --tlsv1.2 \
         "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/${asset}" \
         --output "/tmp/${asset}" \
    && echo "${digest}  /tmp/${asset}" | sha256sum --check --strict \
    && mkdir -p "/opt/cognia/code-server/${CODE_SERVER_VERSION}" \
    && tar -xzf "/tmp/${asset}" --strip-components=1 \
         -C "/opt/cognia/code-server/${CODE_SERVER_VERSION}" \
    && rm -f "/tmp/${asset}"

# The plugin permission model is pinned independently from the brain's Node
# runtime. cognia-plugin-runtime verifies this exact major/minimum patch before
# executing any installed JavaScript plugin.
FROM node:26.3.1-bookworm-slim AS plugin-node-runtime
RUN node --version

# ── Runtime: slim (sidecar-only execution plane) ────────────────────────────
FROM node:26-bookworm-slim AS runtime-slim
# The binary dynamically links the Tauri desktop stack (see the chef-stage
# note) — ship the runtime .so set alongside the headless essentials.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libssl3 curl git \
       libgtk-3-0 libwebkit2gtk-4.1-0 libjavascriptcoregtk-4.1-0 \
       libsoup-3.0-0 libayatana-appindicator3-1 librsvg2-2 libpipewire-0.3-0 libgbm1 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 cognia \
    && useradd --system --uid 10001 --gid cognia --home-dir /data --shell /usr/sbin/nologin cognia \
    && mkdir -p /data \
    && chown -R cognia:cognia /data

COPY --from=builder /work/target/release/cognia-server /usr/local/bin/cognia-server
COPY --from=builder /work/target/release/cognia /usr/local/bin/cognia
COPY --from=brain-builder /work/cli/dist/bin/cognia-agent-layout /app/brain
# Webclone's Babel analyzer intentionally uses createRequire because Babel 8's
# ESM visitor types do not match its compatibility adapter. The sidecar bundle
# therefore needs this pure-JS runtime closure beside claude-host.mjs.
COPY --from=brain-builder /work/sidecar/webclone/node_modules /app/brain/sidecar/node_modules
COPY --from=brain-builder /work/sidecar/codeserver-agent-ext/cognia-agent-bridge.vsix /opt/cognia/codeserver-agent-ext/cognia-agent-bridge.vsix
COPY --from=codeserver-preload /opt/cognia/code-server /opt/cognia/code-server
COPY --from=plugin-node-runtime /usr/local/bin/node /opt/cognia/plugin-node/bin/node
# Smoke stub agent (ADR-0059 D6): admitted by SpawnPolicy ONLY when
# COGNIA_SMOKE_AGENT=1 is set on the server — inert otherwise.
COPY scripts/smoke/stub-acp-agent.mjs /opt/cognia/smoke/stub-acp-agent.mjs

ENV COGNIA_DATA_DIR=/data \
    COGNIA_BRAIN_ENTRY=/app/brain/cli.mjs \
    COGNIA_PLUGIN_NODE_PATH=/opt/cognia/plugin-node/bin/node \
    COGNIA_SIDECAR_SCRIPT=/app/brain/sidecar/claude-host.mjs \
    COGNIA_VSCODE_EXT_HOST_SCRIPT=/app/brain/sidecar/vscode-ext-host/dist/host.js \
    COGNIA_MCP_SIDECAR_PATH=/app/brain/sidecar/cognia-mcp.mjs
ENV COGNIA_CODE_SERVER_BIN=/opt/cognia/code-server/4.128.0/bin/code-server \
    COGNIA_CODE_SERVER_AGENT_VSIX=/opt/cognia/codeserver-agent-ext/cognia-agent-bridge.vsix
VOLUME /data
# 27890 tracks companion_api::server::DEFAULT_PORT — 7890/7891 are the Clash
# mixed/SOCKS defaults and collide with a proxy on most dev hosts.
EXPOSE 27890

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/cognia-server"]
CMD ["serve", "--port", "27890"]

# ── Runtime: full (external agent CLIs preinstalled + git) ──────────────────
FROM runtime-slim AS runtime-full
USER root
COPY deploy/runner/install-agents.sh /tmp/install-agents.sh
RUN bash /tmp/install-agents.sh \
    && rm -f /tmp/install-agents.sh \
    && rm -rf /var/lib/apt/lists/*
USER 10001:10001

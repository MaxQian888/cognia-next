{
  "id": "cognia-plugin-template",
  "name": "Cognia Plugin Template",
  "version": "0.1.0",
  "description": "Starter template for a Cognia WASM plugin — registers one tool. Generated by `cognia plugin new`.",
  "type": "wasm",
  "capabilities": ["tools"],
  "tools": [
    {
      "name": "template_echo",
      "description": "Echo the supplied message back to the agent. Replace with your own tool.",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The message to echo."
          }
        },
        "required": ["message"],
        "additionalProperties": false
      }
    }
  ],
  "wasmMain": "cognia_plugin_template.wasm",
  "wasm": {
    "apiVersion": "0.2.0",
    "memoryLimitMb": 16,
    "callTimeoutMs": 5000
  },
  "permissions": ["notification"],
  "author": {
    "name": "Your Name",
    "publicKey": ""
  },
  "license": "MIT",
  "engines": {
    "cognia": ">=0.4.0"
  }
}

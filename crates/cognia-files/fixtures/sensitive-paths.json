{
  "_comment": "The workspace sensitive-file floor (ADR-0222 §9.3), one list for both languages. crates/cognia-files/src/files.rs holds it as constants and a test pins those to this file; lib/filespace/sensitive.ts reads this file directly. `cases` are conformance cases both implementations must agree on. Names and segments match case-insensitively.",
  "fileNames": [
    ".env",
    ".envrc",
    ".git-credentials",
    ".netrc",
    ".npmrc",
    ".pgpass",
    ".pypirc",
    "_netrc",
    "id_dsa",
    "id_ecdsa",
    "id_ecdsa_sk",
    "id_ed25519",
    "id_ed25519_sk",
    "id_rsa"
  ],
  "envTemplateSuffixes": ["example", "sample", "template", "dist"],
  "extensions": ["pem", "key", "p12", "pfx", "keychain", "keychain-db"],
  "directories": [".git", ".ssh", ".aws", ".gnupg", ".kube"],
  "directoryPairs": [
    [".config", "gh"],
    [".config", "gcloud"]
  ],
  "cases": [
    { "path": ".env", "sensitive": true },
    { "path": "app/.ENV", "sensitive": true },
    { "path": ".env.production", "sensitive": true },
    { "path": ".env.example", "sensitive": false },
    { "path": ".env.dist", "sensitive": false },
    { "path": "config/.npmrc", "sensitive": true },
    { "path": "_netrc", "sensitive": true },
    { "path": ".git-credentials", "sensitive": true },
    { "path": "keys/id_rsa", "sensitive": true },
    { "path": "keys/id_rsa.pub", "sensitive": true },
    { "path": "keys/id_ed25519_sk", "sensitive": true },
    { "path": "certs/server.pem", "sensitive": true },
    { "path": "certs/server.KEY", "sensitive": true },
    { "path": "login.keychain-db", "sensitive": true },
    { "path": ".git/config", "sensitive": true },
    { "path": "vendor/lib/.git/HEAD", "sensitive": true },
    { "path": ".ssh/config", "sensitive": true },
    { "path": "home/.aws/credentials", "sensitive": true },
    { "path": ".kube/config", "sensitive": true },
    { "path": ".config/gh/hosts.yml", "sensitive": true },
    { "path": ".config/nvim/init.lua", "sensitive": false },
    { "path": "gh/notes.md", "sensitive": false },
    { "path": "src/keyboard.ts", "sensitive": false },
    { "path": "docs/environment.md", "sensitive": false },
    { "path": ".gitignore", "sensitive": false },
    { "path": ".github/workflows/ci.yml", "sensitive": false },
    { "path": "README.md", "sensitive": false }
  ]
}

{
  "name": "cognia-plugin-template-ts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "Cognia frontend TypeScript plugin template",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=neutral --target=es2022 --outfile=dist/index.js --external:react --external:react/jsx-runtime --external:react/jsx-dev-runtime --external:@cognia/plugin-sdk --external:@cognia/plugin-ui --log-level=info",
    "test": "jest",
    "test:watch": "jest --watch"
  },

{
  "name": "cognia-plugin-template-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Cognia frontend TypeScript plugin template",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=neutral --target=es2022 --outfile=dist/index.js --external:@/types/plugin --external:@/lib/* --log-level=info",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}

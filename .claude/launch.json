{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cognia-next",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "cognia-next-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_E2E=1", "NEXT_PUBLIC_SHARED_CHAT_ENABLED=true", "pnpm", "dev"],
      "port": 3000
    },
    {
      "name": "cognia-next-web-headless",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web-headless"],
      "port": 3000
    },
    {
      "name": "cognia-next-static",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start"],
      "port": 3000
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "docs", "exec", "next", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "next", "dev"],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["storybook", "--no-open"],
      "port": 6006
    }
  ]
}

{
  "id": "cognia-external-agent-preset-example",
  "name": "External Agent Preset Example",
  "version": "0.1.0",
  "description": "Reference plugin demonstrating the external-agent-preset capability and the declarative contextProviders manifest field.",
  "type": "frontend",
  "capabilities": ["external-agent-preset", "context-provider"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": { "cognia": ">=0.1.0" },
  "activationEvents": ["startup"],
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" },
    "mobile": { "availability": "supported", "entrypoint": "src/index.ts" }
  }
}

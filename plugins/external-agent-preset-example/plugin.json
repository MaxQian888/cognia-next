{
  "id": "cognia-external-agent-preset-example",
  "name": "External Agent Preset Example",
  "version": "0.1.0",
  "description": "Reference plugin demonstrating the external-agent-preset capability and the declarative contextProviders manifest field.",
  "type": "frontend",
  "capabilities": ["external-agent-preset", "context-provider"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "activationEvents": ["startup"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "mobile": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    }
  },
  "externalAgentPresets": [
    {
      "id": "example-acp-cli",
      "name": "Example ACP CLI",
      "description": "A reference external agent preset wired over ACP stdio.",
      "protocol": "acp",
      "transport": "stdio",
      "process": {
        "command": "npx",
        "args": ["-y", "example-acp-agent", "--stdio"]
      },
      "envVarHint": "EXAMPLE_ACP_API_KEY",
      "defaultPermissionMode": "default",
      "supportTier": "documented-only",
      "tags": ["example", "reference"]
    }
  ],
  "contextProviders": [
    {
      "id": "env-banner",
      "label": "Environment Banner",
      "entry": "src/context-provider.ts",
      "export": "createEnvBannerProvider"
    }
  ]
}

{
  "id": "github-delivery",
  "name": "GitHub Delivery",
  "version": "1.0.0",
  "description": "Bring GitHub PR review, Issue→PR loops, and Release automation into the cognia visual workflow editor.",
  "type": "frontend",
  "capabilities": ["tools", "components", "providers", "exporters", "connectors"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "permissions": [
    "network:fetch",
    "secrets:read",
    "secrets:write",
    "terminal:spawn",
    "terminal:write"
  ],
  "activationEvents": ["startup"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "PR review, Issue→PR loops, and Dexie persistence work over fetch + IndexedDB; the terminal-based exporter needs a desktop shell."
    }
  },
  "dexie": {
    "tables": [
      { "name": "repos", "schema": "&fullName, credentialMode, createdAt" },
      {
        "name": "workOrders",
        "schema": "++id, [status+repoFullName], issueNumber, prNumber, createdAt, updatedAt"
      },
      {
        "name": "events",
        "schema": "&deliveryId, [repoFullName+seenAt], kind, source"
      },
      {
        "name": "audit",
        "schema": "++id, [repoFullName+at], runId, &[runId+stepId+at]"
      }
    ]
  },
  "connectors": [
    {
      "type": "github",
      "factory": "createGithubAdapterForBridge",
      "configSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "transportModes": []
    }
  ]
}

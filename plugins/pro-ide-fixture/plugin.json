{
  "id": "cognia-pro-ide-fixture",
  "name": "Pro IDE Contribution (fixture)",
  "nameKey": "manifest.name",
  "version": "0.1.0",
  "description": "Fixture plugin for the managed Pro IDE's real-binary E2E (ADR-0088). It contributes one of every family the platform claims for a stable release, each trivially: a command and a CodeLens, a language server (hover), a debug adapter, an MCP server, a source control, a test controller, a notebook serializer and kernel, a webview view and a custom editor, and a chat participant, language model and tool. The E2E drives each through a real code-server and fails if any one of them does not round-trip.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["editor"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "permissions": [
    "editor:read",
    "process:spawn",
    "debug:control",
    "git:read",
    "tests:run",
    "notebook:execute",
    "extension:ui",
    "agent:control",
    "network:fetch"
  ],
  "activationEvents": ["startup"],
  "ide": {
    "schemaVersion": 1,
    "targets": ["pro-ide"],
    "contributions": {
      "commands": [
        {
          "command": "ping",
          "title": "Pro IDE fixture: ping the plugin runtime",
          "category": "Cognia Fixture"
        }
      ],
      "languages": [
        {
          "id": "cognia-fixture",
          "aliases": ["Cognia Fixture"],
          "extensions": [".cfx"]
        }
      ],
      "debuggers": [
        {
          "type": "fixture-dap",
          "label": "Cognia Fixture Debug",
          "languages": ["cognia-fixture"]
        }
      ],
      "mcpServerDefinitionProviders": [
        {
          "id": "fixture-mcp",
          "label": "Cognia Fixture MCP"
        }
      ],
      "notebooks": [
        {
          "type": "fixture-notebook",
          "displayName": "Cognia Fixture Notebook",
          "selector": [
            {
              "filenamePattern": "*.cfxnb"
            }
          ]
        }
      ],
      "customEditors": [
        {
          "viewType": "fixture-editor",
          "displayName": "Cognia Fixture Editor",
          "selector": [
            {
              "filenamePattern": "*.cfxed"
            }
          ],
          "priority": "option"
        }
      ],
      "views": {
        "explorer": [
          {
            "id": "fixture-view",
            "name": "Cognia Fixture View",
            "type": "webview",
            "icon": "$(beaker)"
          }
        ]
      },
      "chatParticipants": [
        {
          "id": "fixture-chat",
          "name": "fixture",
          "fullName": "Cognia Fixture",
          "description": "Answers with a fixed reply."
        }
      ],
      "languageModelChatProviders": [
        {
          "vendor": "fixture-lm",
          "displayName": "Cognia Fixture Model"
        }
      ],
      "languageModelTools": [
        {
          "name": "fixture-tool",
          "displayName": "Cognia Fixture Tool",
          "modelDescription": "Echoes its input text.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": ["text"]
          }
        }
      ]
    },
    "providers": [
      {
        "id": "ping",
        "kind": "command",
        "handler": "ping"
      },
      {
        "id": "fixture-lens",
        "kind": "code-lens",
        "handler": "provideFixtureLenses",
        "permission": "editor:read",
        "selector": [
          {
            "scheme": "file"
          }
        ]
      },
      {
        "id": "fixture-scm",
        "kind": "source-control",
        "handler": "sourceControl",
        "permission": "git:read",
        "metadata": {
          "label": "Cognia Fixture VCS",
          "inputPlaceholder": "Fixture commit message"
        }
      },
      {
        "id": "fixture-tests",
        "kind": "test-controller",
        "handler": "testController",
        "permission": "tests:run",
        "metadata": {
          "label": "Cognia Fixture Tests",
          "runProfiles": [
            {
              "label": "Run",
              "kind": "Run",
              "isDefault": true
            }
          ]
        }
      },
      {
        "id": "fixture-notebook-serializer",
        "kind": "notebook-serializer",
        "handler": "notebookSerializer",
        "permission": "editor:read",
        "metadata": {
          "notebookType": "fixture-notebook"
        }
      },
      {
        "id": "fixture-kernel",
        "kind": "notebook-controller",
        "handler": "notebookKernel",
        "permission": "notebook:execute",
        "metadata": {
          "notebookType": "fixture-notebook",
          "label": "Cognia Fixture Kernel",
          "supportedLanguages": ["plaintext"],
          "supportsExecutionOrder": true
        }
      },
      {
        "id": "fixture-view",
        "kind": "webview-view",
        "handler": "webviewView",
        "permission": "extension:ui"
      },
      {
        "id": "fixture-editor",
        "kind": "custom-editor",
        "handler": "customEditor",
        "permission": "extension:ui"
      },
      {
        "id": "fixture-chat",
        "kind": "chat-participant",
        "handler": "chatParticipant",
        "permission": "agent:control"
      },
      {
        "id": "fixture-lm",
        "kind": "language-model-chat-provider",
        "handler": "languageModel",
        "permission": "network:fetch",
        "metadata": {
          "vendor": "fixture-lm"
        }
      },
      {
        "id": "fixture-tool",
        "kind": "language-model-tool",
        "handler": "languageModelTool",
        "permission": "agent:control"
      }
    ],
    "executables": [
      {
        "id": "fixture-lsp-server",
        "source": {
          "kind": "plugin-resource",
          "path": "servers/lsp-server.mjs",
          "sha256": "sha256:25e33f78582c38242614c469ae8c1a69a69d26cbf716e2f72f89aea3f504103c"
        }
      },
      {
        "id": "fixture-dap-server",
        "source": {
          "kind": "plugin-resource",
          "path": "servers/dap-server.mjs",
          "sha256": "sha256:6c7d84d23367419a43eb19c38194f824f2093a7e3439ec7e18a86cc3f6e5fe46"
        }
      },
      {
        "id": "fixture-mcp-server",
        "source": {
          "kind": "plugin-resource",
          "path": "servers/mcp-server.mjs",
          "sha256": "sha256:cf54557027ddc639417be1bcb5c7ec250fdaf7808c157c3cf7056f551cbc9b12"
        }
      }
    ],
    "protocols": {
      "lsp": [
        {
          "id": "fixture-lsp",
          "executable": "fixture-lsp-server",
          "transport": "stdio",
          "languages": ["cognia-fixture"]
        }
      ],
      "dap": [
        {
          "id": "fixture-dap",
          "executable": "fixture-dap-server",
          "transport": "stdio"
        }
      ],
      "mcp": [
        {
          "id": "fixture-mcp",
          "executable": "fixture-mcp-server",
          "transport": "stdio"
        }
      ]
    }
  },
  "runtimeCompatibility": {
    "browser": {
      "availability": "blocked",
      "reason": "The managed Pro IDE proxy pathway requires the embedded code-server — desktop only."
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts",
      "reason": "Enabling the plugin builds and activates a signed proxy VSIX; the broker then calls its providers and supervises its protocol servers over the agent channel."
    },
    "mobile": {
      "availability": "blocked",
      "reason": "The managed Pro IDE proxy pathway requires the embedded code-server — unavailable on mobile."
    }
  },
  "i18n": {
    "locales": {
      "en": {
        "manifest.name": "Pro IDE Contribution (fixture)",
        "manifest.description": "Fixture plugin for the managed Pro IDE's real-binary E2E (ADR-0088). It contributes one of every family the platform claims for a stable release, each trivially: a command and a CodeLens, a language server (hover), a debug adapter, an MCP server, a source control, a test controller, a notebook serializer and kernel, a webview view and a custom editor, and a chat participant, language model and tool. The E2E drives each through a real code-server and fails if any one of them does not round-trip."
      },
      "zh-CN": {
        "manifest.name": "Pro IDE 贡献（测试夹具）",
        "manifest.description": "托管 Pro IDE 真实二进制 E2E 的夹具插件（ADR-0088）。平台为稳定版承诺的每一类能力各贡献一个最简实现：命令与 CodeLens、语言服务器（悬停）、调试适配器、MCP 服务器、源代码管理、测试控制器、notebook 序列化器与内核、webview 视图与自定义编辑器，以及聊天参与者、语言模型和工具。E2E 通过真实的 code-server 逐一驱动，任何一类无法完成往返都会失败。"
      }
    }
  }
}

{
  "id": "cognia-kimi-subscription",
  "name": "Kimi Code Subscription",
  "nameKey": "manifest.name",
  "version": "0.3.0",
  "icon": "assets/icon.png",
  "description": "Kimi Code membership accounts, models, and plan usage. Separate from Moonshot pay-as-you-go API.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["subscription-provider"],
  "permissions": [],
  "main": "dist/index.js",
  "author": {
    "name": "cognia-next"
  },
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "activationEvents": ["startup"],
  "bundle_include": ["README.md", "README.zh-CN.md", "assets/icon.png"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "blocked",
      "reason": "Subscription accounts require Cognia's desktop credential vault."
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "dist/index.js"
    },
    "mobile": {
      "availability": "blocked",
      "reason": "Subscription accounts require Cognia's desktop credential vault."
    }
  },
  "subscriptionProviders": [
    {
      "id": "kimi-code",
      "name": "Kimi Code",
      "description": "Kimi Code membership API. Additional models require eligible membership tiers.",
      "protocol": "openai",
      "baseUrl": "https://api.kimi.com/coding/v1",
      "models": [
        {
          "id": "kimi-for-coding",
          "name": "Kimi for Coding",
          "contextLength": 1048576,
          "supportsTools": true,
          "supportsVision": true,
          "supportsVideo": false,
          "supportsAudio": false,
          "supportsReasoning": true,
          "supportsStreaming": true
        },
        {
          "id": "k3-256k",
          "name": "K3 256K",
          "contextLength": 262144,
          "supportsTools": true,
          "supportsVision": true,
          "supportsVideo": false,
          "supportsAudio": false,
          "supportsReasoning": true,
          "supportsStreaming": true
        },
        {
          "id": "k3",
          "name": "K3",
          "contextLength": 262144,
          "supportsTools": true,
          "supportsVision": true,
          "supportsVideo": false,
          "supportsAudio": false,
          "supportsReasoning": true,
          "supportsStreaming": true
        },
        {
          "id": "kimi-for-coding-highspeed",
          "name": "Kimi for Coding HighSpeed",
          "contextLength": 262144,
          "supportsTools": true,
          "supportsVision": true,
          "supportsVideo": false,
          "supportsAudio": false,
          "supportsReasoning": true,
          "supportsStreaming": true
        }
      ],
      "apiKeyUrl": "https://www.kimi.com/code/console",
      "usageUrl": "https://www.kimi.com/code/console",
      "docsUrl": "https://www.kimi.com/code/docs/en/kimi-code/models.html",
      "apiFlavor": "chat",
      "modelApi": {
        "list": true,
        "retrieve": false
      },
      "billingMode": "subscription",
      "brandId": "kimi",
      "relatedProviderIds": ["moonshot"],
      "usage": {
        "request": {
          "useBaseUrlOrigin": true,
          "path": "/coding/v1/usages",
          "method": "GET"
        },
        "extract": {
          "kind": "window",
          "windows": [
            {
              "id": "plan",
              "labelKey": "subscription.limits.meter.plan",
              "usedPath": "usage.used",
              "remainingPath": "usage.remaining",
              "totalPath": "usage.limit",
              "resetAtPath": "usage.resetTime",
              "resetUnit": "iso"
            }
          ]
        }
      }
    },

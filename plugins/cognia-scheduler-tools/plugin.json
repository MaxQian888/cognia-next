{
  "id": "cognia-scheduler-tools",
  "name": "Scheduler Tools",
  "version": "0.1.0",
  "description": "Lets an in-chat agent create, list, cancel, and run scheduled tasks (gated by the scheduler permission policy).",
  "type": "frontend",
  "capabilities": ["tools", "scheduler"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "activationEvents": ["onStartup"],
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" }
  }
}

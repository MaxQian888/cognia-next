{
  "id": "wasm-example-formatter",
  "name": "WASM Example: Rust Formatter",
  "version": "0.1.0",
  "description": "Reference plugin showing fs + process + workflow composition: invokes rustfmt on input source via the cognia WASM process capability.",
  "type": "wasm",
  "capabilities": ["tools", "workflow"],
  "wasmMain": "wasm_example_formatter.wasm",
  "wasm": {
    "apiVersion": "0.1.0",
    "memoryLimitMb": 32,
    "callTimeoutMs": 15000
  },
  "permissions": ["notification", "filesystem:read", "filesystem:write", "process:spawn"],
  "author": {
    "name": "cognia-next"
  },
  "license": "MIT",
  "tools": [
    {
      "name": "format_rust",
      "description": "Format a Rust source string with rustfmt. Returns the formatted source plus rustfmt's exit code and stderr.",
      "parametersSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Rust source to format"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra rustfmt args (optional)"
          }
        },
        "required": ["source"]
      }
    }
  ],
  "workflows": {
    "nodes": [
      {
        "kind": "action.wasm-example-formatter.format",
        "typeVersion": 1,
        "category": "action",
        "label": "Format Rust",
        "description": "Run rustfmt on a Rust source string",
        "iconName": "Braces",
        "keywords": ["rust", "rustfmt", "format"],
        "paramsSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            }
          },
          "required": ["source"]
        },
        "defaultParams": {
          "source": ""
        },
        "desktopOnly": true
      }
    ]
  },
  "engines": {
    "cognia": ">=0.1.0"
  },
  "runtimeCompatibility": {
    "tauri": {
      "availability": "supported"
    },
    "browser": {
      "availability": "blocked",
      "reason": "Invokes rustfmt via the process:spawn capability \u2014 desktop only."
    },
    "mobile": {
      "availability": "blocked",
      "reason": "Invokes rustfmt via the process:spawn capability \u2014 unavailable on mobile."
    }
  },
  "minAppVersion": "0.1.0"
}

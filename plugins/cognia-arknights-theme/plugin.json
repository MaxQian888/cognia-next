  "densityPresets": [
    {
      "name": "rhodes-command",
      "vars": {
        "--density-spacing": "0.75rem",
        "--density-input-height": "2.25rem",
        "--density-row-padding": "0.45rem",
        "--density-gap": "0.625rem",
        "--density-line-height": "1.45"
      }
    },
    {
      "name": "rhodes-field",
      "vars": {
        "--density-spacing": "1rem",
        "--density-input-height": "2.5rem",
        "--density-row-padding": "0.625rem",
        "--density-gap": "0.875rem",
        "--density-line-height": "1.6"
      }
    }
  ],
  "themePacks": [
    {
      "id": "lemuen-rain-transit",
      "name": "LEMUEN // Rain Transit",
      "description": "A quiet Laterano night scene with Lemuen, low-motion surfaces, and spacious field density for unobtrusive reading.",
      "preview": {
        "light": "/plugins/cognia-arknights-theme/assets/lemuen-rain-transit.webp",
        "dark": "/plugins/cognia-arknights-theme/assets/lemuen-rain-transit.webp"
      },
      "applies": {
        "themeId": "rhodes-operations-dark",
        "wallpaperId": "lemuen-rain-transit",
        "density": "rhodes-field",
        "radius": 0.375,
        "motionSpeed": 0.5
      }
    },
    {
      "id": "surtr-rooftop-break",
      "name": "SURTR // Rooftop Break",
      "description": "Warm sunset concrete, a quiet ice-cream break, and a compact graphite workspace.",

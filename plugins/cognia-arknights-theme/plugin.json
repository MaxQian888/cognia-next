{
  "id": "cognia-arknights-theme",
  "name": "Arknights: Rhodes Operations (Unofficial)",
  "version": "1.0.0",
  "description": "An original, highly customizable tactical-industrial appearance pack inspired by Arknights. Includes complete light and dark palettes, generated wallpapers, density profiles, and one-click theme packs.",
  "type": "frontend",
  "capabilities": ["themes", "theme-pack", "wallpapers", "density-preset"],
  "main": "src/index.ts",
  "icon": "/plugins/cognia-arknights-theme/assets/command-emblem.svg",
  "screenshots": [
    "/plugins/cognia-arknights-theme/assets/lemuen-rain-transit.webp",
    "/plugins/cognia-arknights-theme/assets/operators/reed-flame-shadow-field-clinic.webp",
    "/plugins/cognia-arknights-theme/assets/operators/necrass-moonlit-memorial.webp",
    "/plugins/cognia-arknights-theme/assets/operators/exusiai-new-covenant-dawn-platform.webp",
    "/plugins/cognia-arknights-theme/assets/operators/leizi-thunderbringer-storm-pavilion.webp",
    "/plugins/cognia-arknights-theme/assets/operators/wisadel-londinium-rooftop.webp",
    "/plugins/cognia-arknights-theme/assets/operators/lappland-decadenza-opera.webp",
    "/plugins/cognia-arknights-theme/assets/operators/kaltsit-esperanta-containment-hangar.webp",
    "/plugins/cognia-arknights-theme/assets/operators/hoshiguma-breacher-night-stall.webp",
    "/plugins/cognia-arknights-theme/assets/operators/yu-courtyard-kitchen.webp",
    "/plugins/cognia-arknights-theme/assets/operators/blaze-igniting-spark-maintenance.webp",
    "/plugins/cognia-arknights-theme/assets/operators/surtr-rooftop-ice-cream.webp",
    "/plugins/cognia-arknights-theme/assets/operators/skadi-corrupting-heart-lighthouse.webp",
    "/plugins/cognia-arknights-theme/assets/operations-deck-dark.webp",
    "/plugins/cognia-arknights-theme/assets/operations-deck-light.webp"
  ],
  "keywords": ["arknights", "anime", "tactical", "industrial", "theme", "wallpaper"],
  "author": {
    "name": "cognia-next"
  },
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "activationEvents": ["startup"],
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" },
    "mobile": { "availability": "supported", "entrypoint": "src/index.ts" },
    "headless": {
      "availability": "blocked",
      "reason": "Appearance contributions require an interactive shell."
    }
  },

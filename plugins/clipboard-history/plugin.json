{
  "id": "cognia-clipboard-history",
  "name": "Clipboard History",
  "version": "0.1.0",
  "description": "Persist a rolling clipboard history (encrypted) and surface helpers to retrieve recent entries.",
  "type": "frontend",
  "capabilities": ["tools", "commands", "themes"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "permissions": ["clipboard:read", "settings:read", "settings:write"],
  "activationEvents": ["startup"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Clipboard read is restricted in the mobile WebView; automatic polling capture is unavailable."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "maxEntries": {
        "type": "number",
        "default": 50,
        "description": "Maximum number of clipboard entries to retain."
      },
      "privacyMode": {
        "type": "boolean",
        "default": false,
        "description": "When true, do not persist entries — only surface the most recent in-memory."
      },
      "pollIntervalMs": {
        "type": "number",
        "default": 0,
        "description": "Polling interval (ms). 0 disables automatic capture; entries are then only added by explicit tool / slash-command calls."
      }
    }
  },
  "themes": [
    {
      "id": "clipboard-noir",
      "name": "Clipboard Noir",
      "isDark": true,
      "colors": {
        "background": "#1a1a1f",
        "foreground": "#e6e6e8",
        "primary": "#a78bfa",
        "primaryForeground": "#1a1a1f",
        "secondary": "#2d2d33",
        "secondaryForeground": "#e6e6e8",
        "accent": "#c4b5fd",
        "accentForeground": "#1a1a1f",
        "muted": "#15151a",
        "mutedForeground": "#5b6299",
        "card": "#15151a",
        "cardForeground": "#e6e6e8",
        "popover": "#15151a",
        "popoverForeground": "#e6e6e8",
        "input": "#1a1a1f",
        "border": "#0f0f12",
        "ring": "#5b6299",
        "destructive": "#fb7185",
        "destructiveForeground": "#1a1a1f",
        "sidebar": "#1a1a1f",
        "sidebarForeground": "#e6e6e8",
        "sidebarPrimary": "#a78bfa",
        "sidebarPrimaryForeground": "#1a1a1f",
        "sidebarBorder": "#0f0f12",
        "sidebarAccent": "#2d2d33",
        "sidebarAccentForeground": "#e6e6e8",
        "sidebarRing": "#5b6299"
      }
    },
    {
      "id": "clipboard-paper",
      "name": "Clipboard Paper",
      "isDark": false,
      "colors": {
        "background": "#fafaf7",
        "foreground": "#1f1f23",
        "primary": "#7c3aed",
        "primaryForeground": "#fafaf7",
        "secondary": "#ece9e2",
        "secondaryForeground": "#1f1f23",
        "accent": "#22c55e",
        "accentForeground": "#fafaf7",
        "muted": "#f0ede6",
        "mutedForeground": "#5d5d63",
        "card": "#ffffff",
        "cardForeground": "#1f1f23",
        "popover": "#ffffff",
        "popoverForeground": "#1f1f23",
        "input": "#ece9e2",
        "border": "#d6d3ca",
        "ring": "#7c3aed",
        "destructive": "#dc2626",
        "destructiveForeground": "#fafaf7",
        "sidebar": "#f5f3ec",
        "sidebarForeground": "#1f1f23",
        "sidebarPrimary": "#7c3aed",
        "sidebarBorder": "#d6d3ca",
        "sidebarPrimaryForeground": "#fafaf7",
        "sidebarAccent": "#ece9e2",
        "sidebarAccentForeground": "#1f1f23",
        "sidebarRing": "#7c3aed"
      }
    }
  ]
}

{
  "id": "cognia-clipboard-history",
  "name": "Clipboard History",
  "nameKey": "manifest.name",
  "version": "0.1.0",
  "description": "Persist a rolling clipboard history (encrypted) and surface helpers to retrieve recent entries.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["tools", "commands", "themes"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "permissions": ["clipboard:read", "extension:ui"],
  "activationEvents": ["startup", "onCommand:clipboard-history"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Browsers allow clipboard reads only while the tab is focused and clipboard permission is granted, so automatic polling capture misses copies made elsewhere. Explicit adds and the history itself work."
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Clipboard read is restricted in the mobile WebView; automatic polling capture is unavailable."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "maxEntries": {
        "type": "number",
        "default": 50,
        "minimum": 1,
        "description": "Maximum number of clipboard entries to retain."
      },
      "privacyMode": {
        "type": "boolean",
        "default": false,
        "description": "When true, new entries are not saved to storage — only the most recent capture is kept, in memory, until reload or disable. Entries saved before enabling it stay until cleared."
      },
      "pollIntervalMs": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "description": "Polling interval (ms). 0 disables automatic capture; entries are then only added by the clipboard_history_add tool. Non-zero values below 1000 are raised to 1000 (the host rate-limits clipboard reads)."
      }
    }
  },
  "themes": [
    {
      "id": "clipboard-noir",
      "name": "Clipboard Noir",
      "isDark": true,
      "colors": {
        "background": "#1a1a1f",
        "foreground": "#e6e6e8",
        "primary": "#a78bfa",
        "primaryForeground": "#1a1a1f",
        "secondary": "#2d2d33",
        "secondaryForeground": "#e6e6e8",
        "accent": "#c4b5fd",
        "accentForeground": "#1a1a1f",
        "muted": "#15151a",
        "mutedForeground": "#5b6299",
        "card": "#15151a",
        "cardForeground": "#e6e6e8",
        "popover": "#15151a",
        "popoverForeground": "#e6e6e8",
        "input": "#1a1a1f",
        "border": "#0f0f12",
        "ring": "#5b6299",
        "destructive": "#fb7185",
        "destructiveForeground": "#1a1a1f",
        "sidebar": "#1a1a1f",
        "sidebarForeground": "#e6e6e8",
        "sidebarPrimary": "#a78bfa",
        "sidebarPrimaryForeground": "#1a1a1f",
        "sidebarBorder": "#0f0f12",
        "sidebarAccent": "#2d2d33",
        "sidebarAccentForeground": "#e6e6e8",
        "sidebarRing": "#5b6299"
      }
    },
    {
      "id": "clipboard-paper",
      "name": "Clipboard Paper",
      "isDark": false,
      "colors": {
        "background": "#fafaf7",
        "foreground": "#1f1f23",
        "primary": "#7c3aed",
        "primaryForeground": "#fafaf7",
        "secondary": "#ece9e2",
        "secondaryForeground": "#1f1f23",
        "accent": "#22c55e",
        "accentForeground": "#fafaf7",
        "muted": "#f0ede6",
        "mutedForeground": "#5d5d63",
        "card": "#ffffff",
        "cardForeground": "#1f1f23",
        "popover": "#ffffff",
        "popoverForeground": "#1f1f23",
        "input": "#ece9e2",
        "border": "#d6d3ca",
        "ring": "#7c3aed",
        "destructive": "#dc2626",
        "destructiveForeground": "#fafaf7",
        "sidebar": "#f5f3ec",
        "sidebarForeground": "#1f1f23",
        "sidebarPrimary": "#7c3aed",
        "sidebarBorder": "#d6d3ca",
        "sidebarPrimaryForeground": "#fafaf7",
        "sidebarAccent": "#ece9e2",
        "sidebarAccentForeground": "#1f1f23",
        "sidebarRing": "#7c3aed"
      }
    }
  ],
  "commands": [
    {
      "id": "clipboard-history",
      "name": "/clipboard-history",
      "description": "Show recent clipboard entries.",
      "descriptionKey": "commands.clipboard-history.description",
      "icon": "Clipboard"
    }
  ],
  "i18n": {
    "locales": {
      "en": {
        "manifest.name": "Clipboard History",
        "manifest.description": "Persist a rolling clipboard history (encrypted) and surface helpers to retrieve recent entries.",
        "format.locale": "en",
        "card.title": "Clipboard history",
        "card.countOne": "1 entry",
        "card.countOther": "{count} entries",
        "card.empty": "No clipboard entries yet.",
        "card.copy": "Copy entry",
        "card.showAll": "Show all {count}",
        "card.showLess": "Show less",
        "card.privacyMode": "Privacy mode: only the latest capture is kept, in memory.",
        "command.empty": "Clipboard history is empty.",
        "command.header": "Recent clipboard entries ({shown} of {total}, newest first):",
        "command.privacyNote": "Privacy mode is on: new captures are kept in memory only.",
        "commands.clipboard-history.description": "Show recent clipboard entries."
      },
      "zh-CN": {
        "manifest.name": "剪贴板历史",
        "manifest.description": "（加密）保存滚动的剪贴板历史，并提供读取最近条目的工具。",
        "format.locale": "zh-CN",
        "card.title": "剪贴板历史",
        "card.countOne": "1 条",
        "card.countOther": "{count} 条",
        "card.empty": "暂无剪贴板记录。",
        "card.copy": "复制该条",
        "card.showAll": "显示全部 {count} 条",
        "card.showLess": "收起",
        "card.privacyMode": "隐私模式：仅在内存中保留最近一条记录。",
        "command.empty": "剪贴板历史为空。",
        "command.header": "最近的剪贴板记录（共 {total} 条，显示最新 {shown} 条）：",
        "command.privacyNote": "隐私模式已开启：新的记录仅保存在内存中。",
        "commands.clipboard-history.description": "显示最近的剪贴板记录。"
      }
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "jest"],
    "paths": {
      "@cognia/plugin-sdk": ["./types/cognia-plugin-sdk.d.ts"],
      "@cognia/plugin-ui": ["./types/cognia-plugin-ui.d.ts"],
      "@cognia/provider-types": ["./types/provider-types/index.d.ts"],
      "@cognia/provider-types/*": ["./types/provider-types/*.d.ts"],
      "@cognia/provider-core": ["./types/provider-core/index.d.ts"],
      "@cognia/provider-core/*": ["./types/provider-core/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "plugin.json"],
  "exclude": ["node_modules", "dist"]
}

{
  "id": "cognia-context-inspector",
  "name": "Context Inspector (Developer)",
  "nameKey": "manifest.name",
  "version": "0.1.0",
  "description": "Developer tool: a Context Workbench panel showing the live workbench state — the reference consumer for declarative webview-backed context panels. Off by default; enable it on the Plugins page.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["context-panel", "webview"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "permissions": ["extension:ui", "session:read"],
  "runtimeCompatibility": {
    "browser": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "tauri": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    },
    "mobile": {
      "availability": "supported",
      "entrypoint": "src/index.ts"
    }
  },
  "i18n": {
    "locales": {

{
  "id": "cognia-documents",
  "name": "Cognia Documents",
  "nameKey": "manifest.name",
  "version": "0.1.0",
  "description": "Plugin-owned native DOCX authoring, import, editing, review, preview, validation, and export.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["tools", "importers", "exporters"],
  "main": "src/index.ts",
  "author": { "name": "cognia-next" },
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": { "cognia": ">=0.1.0" },
  "permissions": [
    "artifact:read",
    "artifact:write",
    "filesystem:read",
    "filesystem:write",
    "export:session"
  ],
  "activationEvents": ["startup"],
  "i18n": {

  },
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" },
    "headless": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Authoring and validation are available; interactive preview and file pickers require a UI shell."
    },
    "mobile": {
      "availability": "supported",
      "entrypoint": "src/index.ts",
      "reason": "Authoring, review, and preview work on mobile; DOCX import uses the system file picker and exports are saved to Documents/cognia/exports on the device."
    }
  }
}

{
  "id": "cognia-appearance-demo",
  "name": "Appearance Demo",
  "nameKey": "manifest.name",
  "version": "0.1.0",
  "description": "Reference plugin exercising the appearance contribution surfaces: a CSS-variable theme, a theme pack (one-click bundle), a gradient wallpaper, and a named density preset.",
  "descriptionKey": "manifest.description",
  "type": "frontend",
  "capabilities": ["themes", "theme-pack", "wallpapers", "density-preset"],
  "main": "src/index.ts",
  "author": "cognia-next",
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": {
    "cognia": ">=0.1.0"
  },
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" },
    "mobile": { "availability": "supported", "entrypoint": "src/index.ts" },
    "headless": {
      "availability": "blocked",
      "reason": "Appearance contributions require an interactive shell."
    }
  },
  "themes": [
    {
      "id": "neon-noir",
      "name": "Neon Noir",
      "isDark": true,
      "cssVariables": {
        "--background": "oklch(0.16 0.02 275)",
        "--foreground": "oklch(0.96 0.01 275)",
        "--card": "oklch(0.2 0.02 275)",
        "--card-foreground": "oklch(0.96 0.01 275)",
        "--popover": "oklch(0.2 0.02 275)",
        "--popover-foreground": "oklch(0.96 0.01 275)",
        "--muted": "oklch(0.24 0.02 275)",
        "--muted-foreground": "oklch(0.72 0.02 275)",
        "--border": "oklch(0.32 0.03 285)",
        "--input": "oklch(0.28 0.03 285)",
        "--ring": "oklch(0.72 0.19 305)",
        "--primary": "oklch(0.72 0.19 305)",
        "--primary-foreground": "oklch(0.16 0.02 275)",
        "--secondary": "oklch(0.5 0.08 285)",
        "--secondary-foreground": "oklch(0.96 0.01 275)",
        "--accent": "oklch(0.7 0.17 195)",
        "--accent-foreground": "oklch(0.16 0.02 275)",
        "--brand-action": "oklch(0.7 0.17 195)",
        "--brand-approval": "oklch(0.82 0.15 85)",
        "--brand-wash": "oklch(0.22 0.04 295)",
        "--destructive": "oklch(0.7 0.19 20)",
        "--destructive-foreground": "oklch(0.16 0.02 275)",
        "--success": "oklch(0.77 0.15 155)",
        "--success-foreground": "oklch(0.16 0.02 275)",
        "--warning": "oklch(0.82 0.15 85)",
        "--warning-foreground": "oklch(0.16 0.02 275)",
        "--info": "oklch(0.76 0.12 235)",
        "--info-foreground": "oklch(0.16 0.02 275)",
        "--sidebar": "oklch(0.13 0.02 275)",
        "--sidebar-foreground": "oklch(0.93 0.01 275)",
        "--sidebar-primary": "oklch(0.72 0.19 305)",
        "--sidebar-primary-foreground": "oklch(0.16 0.02 275)",
        "--sidebar-accent": "oklch(0.24 0.03 285)",
        "--sidebar-accent-foreground": "oklch(0.96 0.01 275)",
        "--sidebar-border": "oklch(0.28 0.03 285)",
        "--sidebar-ring": "oklch(0.72 0.19 305)",
        "--chart-1": "oklch(0.72 0.19 305)",
        "--chart-2": "oklch(0.7 0.17 195)",
        "--chart-3": "oklch(0.82 0.15 85)",
        "--chart-4": "oklch(0.77 0.15 155)",
        "--chart-5": "oklch(0.72 0.18 350)",
        "--wf-trigger": "oklch(0.77 0.15 155)",
        "--wf-action": "oklch(0.76 0.12 235)",
        "--wf-ai": "oklch(0.72 0.19 305)",
        "--wf-flow": "oklch(0.82 0.15 85)",
        "--wf-data": "oklch(0.74 0.15 30)",
        "--wf-io": "oklch(0.7 0.17 195)",
        "--wf-annotation": "oklch(0.66 0.02 275)",
        "--wf-status-idle": "oklch(0.66 0.02 275)",
        "--wf-status-running": "oklch(0.82 0.15 85)",
        "--wf-status-succeeded": "oklch(0.77 0.15 155)",
        "--wf-status-failed": "oklch(0.7 0.19 20)",
        "--wf-status-skipped": "oklch(0.5 0.02 275)",
        "--wf-status-waiting": "oklch(0.76 0.12 235)",
        "--effort-ultra": "oklch(0.72 0.19 305)",
        "--effort-ultra-muted": "oklch(0.32 0.08 305)"
      }
    }
  ],
  "wallpapers": [
    {
      "id": "demo-aurora",
      "name": "Demo Aurora",
      "source": {
        "kind": "gradient",
        "css": "linear-gradient(135deg, #1e3a8a 0%, #7c3aed 50%, #db2777 100%)"
      }
    }
  ],
  "densityPresets": [
    {
      "name": "demo-airy",
      "vars": {
        "--density-spacing": "1.25rem",
        "--density-input-height": "2.75rem",
        "--density-row-padding": "0.75rem",
        "--density-gap": "1rem",
        "--density-line-height": "1.7"
      }
    }
  ],
  "themePacks": [
    {
      "id": "aurora-comfort",
      "name": "Aurora Comfort",
      "description": "Ocean accent + the Demo Aurora wallpaper + an airy density and soft corners.",
      "applies": {
        "themeId": "ocean",
        "wallpaperId": "demo-aurora",
        "density": "demo-airy",
        "radius": 0.75
      }
    }
  ],
  "i18n": {
    "locales": {
      "en": {
        "manifest.name": "Appearance Demo",
        "manifest.description": "Reference plugin exercising the appearance contribution surfaces: a CSS-variable theme, a theme pack (one-click bundle), a gradient wallpaper, and a named density preset."
      },
      "zh-CN": {
        "manifest.name": "外观示例",
        "manifest.description": "演示外观类贡献的参考插件：一个 CSS 变量主题、一个主题包（一键组合）、一张渐变壁纸和一个命名的密度预设。"
      }
    }
  }
}

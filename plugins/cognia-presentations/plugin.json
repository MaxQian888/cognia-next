{
  "id": "cognia-presentations",
  "name": "Cognia Presentations",
  "version": "0.1.0",
  "description": "Plugin-owned native PPTX authoring, import, preview, validation, and export.",
  "type": "frontend",
  "capabilities": ["tools", "importers"],
  "main": "src/index.ts",
  "author": { "name": "cognia-next" },
  "license": "MIT",
  "minAppVersion": "0.1.0",
  "engines": { "cognia": ">=0.1.0" },
  "permissions": ["artifact:read", "artifact:write", "filesystem:read", "filesystem:write"],
  "activationEvents": ["startup"],
  "i18n": {
    "locales": {
      "en": {
        "renderer.name": "Cognia Presentation",
        "preview.slides": "Slides",
        "preview.slideOf": "Slide {index} of {total}",
        "preview.slideLabel": "Slide {index}: {title}",
        "preview.notes": "Speaker notes",
        "preview.validation": "Validation",
        "preview.empty": "This presentation has no slides yet.",
        "preview.chart": "Chart",
        "preview.chartSummary": "{title}: {count} bars",
        "importer.name": "PowerPoint presentation",
        "importer.description": "Import PPTX into the Cognia presentation model.",
        "importer.binaryRequired": "PPTX import requires binary content.",
        "importer.failed": "PPTX import failed.",
        "card.title": "Presentation",
        "card.slides": "Slides: {count}",
        "card.errors": "Errors: {count}",
        "card.warnings": "Warnings: {count}",
        "card.exported": "Exported {size}",
        "card.open": "Open",
        "card.version": "v{version}"
      },
      "zh-CN": {
        "renderer.name": "Cognia 演示文稿",
        "preview.slides": "幻灯片",
        "preview.slideOf": "第 {index} 张，共 {total} 张",
        "preview.slideLabel": "幻灯片 {index}：{title}",
        "preview.notes": "演讲者备注",
        "preview.validation": "校验",
        "preview.empty": "此演示文稿还没有幻灯片。",
        "preview.chart": "图表",
        "preview.chartSummary": "{title}：{count} 个数据条",
        "importer.name": "PowerPoint 演示文稿",
        "importer.description": "将 PPTX 导入为 Cognia 演示文稿模型。",
        "importer.binaryRequired": "PPTX 导入需要二进制内容。",
        "importer.failed": "PPTX 导入失败。",
        "card.title": "演示文稿",
        "card.slides": "幻灯片：{count}",
        "card.errors": "错误：{count}",
        "card.warnings": "警告：{count}",
        "card.exported": "已导出 {size}",
        "card.open": "打开",
        "card.version": "版本 {version}"
      }
    }
  },
  "runtimeCompatibility": {
    "browser": { "availability": "supported", "entrypoint": "src/index.ts" },
    "tauri": { "availability": "supported", "entrypoint": "src/index.ts" },
    "headless": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Authoring and PPTX validation are available; interactive preview and file pickers require a UI shell."
    },
    "mobile": {
      "availability": "degraded",
      "entrypoint": "src/index.ts",
      "reason": "Authoring, preview, and download are available; native file dialogs depend on the connected shell."
    }
  }
}

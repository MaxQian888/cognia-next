# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
junit.xml
*.test.js.snap
*.test.ts.snap
*.test.tsx.snap

# Playwright E2E artifacts
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#Windsurf
.windsurfrules
.ace-tool/

# docs workspace
/docs/.next/
/docs/.source/
/docs/superpowers/

# Claude Code user-local state (per-user, not committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# coverage / build artifact dumps
coverage_output.txt
.playwright-mcp
.VSCodeCounter

# Rust build artifacts. The workspace target/ lives at repo root (members:
# src-tauri, crates/cognia-cli). signaling-server stays standalone with its
# own target/, and each WASM plugin under crates/* or plugins/* builds via
# `cargo component` into its own target/ as well.
/target/
/signaling-server/target/
/crates/*/target/
/plugins/*/target/

# Cargo / rustc transient state. `Cargo.lock` at the workspace root IS
# committed (binary crates need reproducible builds); per-member lockfiles
# under members/ are not — cargo uses the workspace root one. The leftover
# `/src-tauri/Cargo.lock` and `/crates/cognia-cli/Cargo.lock` paths exist
# only so a stray file there is caught instead of accidentally committed.
/src-tauri/Cargo.lock
/crates/*/Cargo.lock

# rustfmt backup files (created by `rustfmt --backup`) and rustc ICE dumps.
*.rs.bk
rustc-ice-*.txt

# Windows debug-info sidecars from `cargo build` on MSVC — these end up in
# target/ already (covered above), but if a build script copies one out
# to the repo it stays out of git.
*.pdb

# local lint / verification dumps
.lint-output.*
.lint.log
.lint-i18n.log
.lint-i18n.json
.typecheck.log
.test-coverage.log
.sidecar-test.log
.audit-slots.log
.discover.json
.citest-map.json
.ci/
.codegraph/
batch-final-verify-*.png
workflows-*.png
dist

# IDE-local data (Tallycode VSCode extension cache)
.vscode/.tallycode/

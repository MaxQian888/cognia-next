# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
junit.xml
*.test.js.snap
*.test.ts.snap
*.test.tsx.snap

# Playwright E2E artifacts
/playwright-report/
/test-results/
/playwright/.cache/

# next.js
/.next/
/out/

# Live2D Cubism Core — proprietary, fetched at build time by
# scripts/download-cubism-core.mjs (predev/prebuild). Never committed.
/public/live2d/

# production
/build

# misc
.DS_Store
*.pem

# python bytecode (plugin runtime imports plugins/*/main.py)
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#Windsurf
.windsurfrules
.ace-tool/

# docs workspace
/docs/.next/
/docs/.source/
/docs/superpowers/

# Claude Code user-local state (per-user, not committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# coverage / build artifact dumps
coverage_output.txt
cov.out.txt
tsc.out.txt
*.out.txt
.playwright-mcp
.VSCodeCounter

# Rust build artifacts. The workspace target/ lives at repo root (members:
# src-tauri, crates/cognia-cli). services/signaling-server is its own Cargo
# workspace (root axum pkg + `core/` member → shared
# `services/signaling-server/target/`); the Cloudflare Worker in
# `services/signaling-server/worker/` is EXCLUDED from that workspace (it
# targets wasm32) so it builds into its own target/, and `worker-build` emits
# the JS shim into `worker/build/`. Each WASM plugin under crates/* or
# plugins/* builds via `cargo component` into its own target/ too.
/target/
/services/signaling-server/target/
/services/signaling-server/worker/target/
/services/signaling-server/worker/build/
# services/share-server mirrors signaling-server: its own Cargo workspace (root
# axum pkg + `core/` member → shared `services/share-server/target/`); the TS
# `worker/` is not a Cargo crate but carries its own node build state.
/services/share-server/target/
/crates/*/target/
/plugins/*/target/

# Cargo / rustc transient state. `Cargo.lock` at the workspace root IS
# committed (binary crates need reproducible builds); per-member lockfiles
# under members/ are not — cargo uses the workspace root one. The leftover
# `/src-tauri/Cargo.lock` and `/crates/cognia-cli/Cargo.lock` paths exist
# only so a stray file there is caught instead of accidentally committed.
/src-tauri/Cargo.lock
/crates/*/Cargo.lock

# rustfmt backup files (created by `rustfmt --backup`) and rustc ICE dumps.
*.rs.bk
rustc-ice-*.txt

# Windows debug-info sidecars from `cargo build` on MSVC — these end up in
# target/ already (covered above), but if a build script copies one out
# to the repo it stays out of git.
*.pdb

# local lint / verification dumps
.lint-output.*
.lint.log
.lint-i18n.log
.lint-i18n.json
.typecheck.log
.test-coverage.log
.sidecar-test.log
.audit-slots.log
.discover.json
.citest-map.json
.ci/
.codegraph/
batch-final-verify-*.png
workflows-*.png
dist

# IDE-local data (Tallycode VSCode extension cache)
.vscode/.tallycode/
.wrangler/
tmp/

# Standalone agent CLI build output
cli/dist/

# Superpowers brainstorming visual companion
.superpowers/

# Storybook static build output
storybook-static/

# Conversation/share export artifacts (produced by /export)
cognia-export-*.md

{
  "name": "cognia-share-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Cloudflare Worker for cognia zero-knowledge public share links (R2 + KV).",
  "type": "module",
  "scripts": {

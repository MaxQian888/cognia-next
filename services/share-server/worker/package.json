    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260928.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.142.0"
  }
}

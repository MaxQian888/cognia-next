# Read-only status mirror: copies the primary's public snapshots/feeds and
# serves the exported status page on 127.0.0.1:8080 behind Caddy (TLS).

[Unit]
Description=Cognia status read-only mirror
Documentation=file:///opt/cognia-status-probe/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/cognia-status-probe/current/cognia-status-probe.mjs mirror --config /etc/cognia-status-mirror/config.json
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

DynamicUser=yes
# Synced snapshot/feed copies: /var/lib/cognia-status-mirror/data
StateDirectory=cognia-status-mirror
StateDirectoryMode=0755
UMask=0022

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cognia-status-mirror
# Released static assets (versioned dirs + `current` symlink), read-only here.
ReadOnlyPaths=/srv/cognia-status-mirror
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Return EPERM for a filtered call instead of killing Node with SIGSYS.
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target

# External reference probe for the Cognia public signaling status service.
# Install: see deploy/README.md. The process is outbound-only (HTTPS/WSS to
# signaling.cognia.cn and status.cognia.cn); it listens on nothing.

[Unit]
Description=Cognia status external probe
Documentation=file:///opt/cognia-status-probe/README.md
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/cognia-status-probe/current/cognia-status-probe.mjs run --config /etc/cognia-status-probe/config.json
Restart=always
RestartSec=5
# SIGTERM aborts in-flight runs and leaves pending batches in the spool.
KillSignal=SIGTERM
TimeoutStopSec=20

# Ephemeral unprivileged user; spool lives in /var/lib/cognia-status-probe.
DynamicUser=yes
StateDirectory=cognia-status-probe
StateDirectoryMode=0700
# The secret is handed over by systemd, readable only by this unit:
#   /run/credentials/cognia-status-probe.service/probe-secret
LoadCredential=probe-secret:/etc/cognia-status-probe/probe.secret
UMask=0077

# Sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cognia-status-probe
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Return EPERM for a filtered call instead of killing Node with SIGSYS.
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# V8 needs to JIT; do not set MemoryDenyWriteExecute.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target

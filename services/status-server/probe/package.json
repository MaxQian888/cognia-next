{
  "name": "cognia-status-probe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "External synthetic probe and read-only mirror for the Cognia public signaling status service.",
  "type": "module",
  "bin": {
    "cognia-status-probe": "./dist/cognia-status-probe.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}

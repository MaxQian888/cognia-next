{
  "name": "cognia-update-worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Cloudflare Worker control plane for Cognia updates (signed catalog + Tauri updater endpoint, D1-backed rollout).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "migrate:local": "wrangler d1 migrations apply cognia-updates --local",
    "migrate": "wrangler d1 migrations apply cognia-updates --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}

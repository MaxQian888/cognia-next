# syntax=docker/dockerfile:1.12
## cognia-server — headless Cognia container (ADR-0059 W6).
##
## Stages:
##   chef → planner → deps        cargo-chef: the tauri/wasmtime dependency
##                                cook is the expensive, highly-cacheable layer
##                                (invalidated only by manifest/lock changes).
##   builder | check              full release build vs. codegen-free
##                                `cargo check` (the PR CI target).
##   brain-builder                Node stage bundling the brain (cognia-agent
##                                CLI layout) + sidecar via
##                                scripts/build/build-cli-binary.mjs --layout-only.
##   plugin-node-runtime          pinned Node used only for sandboxed JS plugins.
##   runtime-slim                 binary + brain + sidecar (default image).
##   runtime-full                 + git + preinstalled external agent CLIs
##                                (deploy/runner/install-agents.sh — shared with
##                                the cognia-runner image so versions can't drift).
##
## Usage:
##   docker build -f deploy/docker/Dockerfile.cognia-server --target runtime-slim -t cognia-server .
##   docker run --rm -v $HOME/cognia-data:/data cognia-server init
##   docker run --rm -v $HOME/cognia-data:/data -p 27890:27890 cognia-server serve --port 27890 --no-mdns
##
## The container expects `/data` to be a writable volume so the SQLite store,
## the secret store, and the self-signed TLS cert persist across restarts.
## Headless secret-store note (ADR-0059 W5, ADR-0224 A1): there is no OS
## keyring in a container. `init` writes `/data/master.key` (0600), which
## `serve` reads when COGNIA_MASTER_KEY / COGNIA_MASTER_KEY_FILE are unset.
## Back that file up: without it the secret store cannot be read.

# ── Rust: cargo-chef base ────────────────────────────────────────────────────
# Base tracks the `rust-toolchain.toml` pin (1.99); matching the base avoids
# downloading a second channel at build time.
# Debian trixie, not bookworm: PaddleOCR (the app's default `ocr-paddle`
# feature) links ONNX Runtime's prebuilt static library, which needs glibc
# 2.38+ and GCC 13's libstdc++. Bookworm's glibc 2.36 left the final link with
# undefined `__isoc23_strtoll` and `_M_replace_cold`. Every stage that runs a
# binary from here (brain-builder, the runtimes) is trixie too.
FROM rust:1.99.0-trixie AS chef
# The official image already contains this exact compiler. Override the
# workspace component list for image builds so cargo does not try to download
# development components while preparing an otherwise compile-only image.
ENV RUSTUP_TOOLCHAIN=1.99.0
# cognia-server is its own Tauri-free package (ADR-0196 P9), so no GTK or
# WebKitGTK: only the libraries its dependencies link. Host screen capture
# (`xcap`, through cognia-automation) links PipeWire, GBM, EGL and the Wayland
# client and server libraries, and bindgens PipeWire with libclang; input
# automation links xkbcommon; the operator CLI links OpenSSL.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       time pkg-config libssl-dev libpipewire-0.3-dev libgbm-dev libegl-dev libwayland-dev \
       libxkbcommon-dev libclang-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --version 0.1.78 --locked
# The workspace release profile is tuned for the desktop bundle (thin-LTO and
# one codegen unit). Compiling the server's graph that way exceeds the memory
# of a standard Linux CI runner even though the headless image does not benefit from
# whole-program desktop optimization. Keep release optimizations while making
# the container build bounded and reproducible on those runners.
ENV CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8 \
    CARGO_BUILD_JOBS=2
WORKDIR /work

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo ./.cargo
COPY src-tauri ./src-tauri
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

# Cache the five shipping build graphs, including their distinct feature sets.
# A workspace-wide cook unifies features differently from these commands and
# makes the CLI/native helper builds recompile dependencies after every source
# edit. Keep these invocations separate: merging packages changes their features.
# One RUN retains all variants without exporting intermediate target snapshots.
FROM chef AS deps
ARG CARGO_REGISTRIES_CRATES_IO_INDEX
ARG CARGO_HTTP_TIMEOUT
ARG CARGO_NET_RETRY
ARG CARGO_NET_GIT_FETCH_WITH_CLI
ARG CARGO_HTTP_MULTIPLEXING
ARG COGNIA_CARGO_REGISTRY_MIRROR=""
COPY rust-toolchain.toml ./
COPY .cargo ./.cargo
COPY --from=planner /work/recipe.json .
RUN if [ -n "${COGNIA_CARGO_REGISTRY_MIRROR}" ]; then \
      printf '[source.crates-io]\nreplace-with = "cognia-mirror"\n[source.cognia-mirror]\nregistry = "%s"\n' \
        "${COGNIA_CARGO_REGISTRY_MIRROR}" > /usr/local/cargo/config.toml; \
    fi
RUN /usr/bin/time -v cargo chef cook --release --locked --timings --recipe-path recipe.json \
      -p cognia-server --bin cognia-server \
      --features container-exec,k8s-exec,workspace-runtime-exec,otel-export \
    && /usr/bin/time -v cargo chef cook --release --locked --timings --recipe-path recipe.json \
      -p cognia-cli --bin cognia \
    && /usr/bin/time -v cargo chef cook --release --locked --timings --recipe-path recipe.json \
      -p cognia-bootstrap-agent --bin cognia-bootstrap \
    && /usr/bin/time -v cargo chef cook --release --locked --timings --recipe-path recipe.json \
      -p cognia-exec-sandbox --bin cognia-external-agent-launcher --bin cognia-sandbox-exec \
    && /usr/bin/time -v cargo chef cook --release --locked --timings --recipe-path recipe.json \
      -p cognia-task-workspace --bin cognia-task-workspace-worker

# The real sidecars and native launchers are built below and staged by
# brain-builder. Every build here selects its package with `-p`: none of them
# compiles the desktop package, and a build without `-p` would unify the
# desktop's `tauri-host` features into the server's graph.
FROM deps AS builder
ARG COGNIA_SERVER_CARGO_FLAGS=""
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src-tauri ./src-tauri
COPY crates ./crates
# Out-of-tree include_str! targets (release: browser overlay JS; the spec
# fixtures under cli/ + docs/ are test-cfg but cheap to keep coherent).
COPY lib/browser/overlay.injected.js lib/browser/automation-core.injected.js ./lib/browser/
COPY lib/tauri/selection-toolbar.ts ./lib/tauri/selection-toolbar.ts
COPY lib/plugin/character-pack/__fixtures__/jcs-vectors.json ./lib/plugin/character-pack/__fixtures__/jcs-vectors.json
COPY lib/router-fusion/gate/run-api-bridge.ts ./lib/router-fusion/gate/run-api-bridge.ts
COPY cli/src/x/agent-launcher.ts ./cli/src/x/agent-launcher.ts
COPY cli/src/runtime/external/codex-catalog ./cli/src/runtime/external/codex-catalog
COPY hooks/matcher-conformance.json hooks/builtin-hooks.lockstep.json ./hooks/
COPY test-fixtures/scheduler/cron-dialect.json ./test-fixtures/scheduler/cron-dialect.json
COPY cli/src/serve/fixtures/bridge-frames.json ./cli/src/serve/fixtures/bridge-frames.json
COPY lib/filespace/link-fixtures.json lib/filespace/path-fixtures.json ./lib/filespace/
COPY lib/headless/runtimes/router-fusion.ts ./lib/headless/runtimes/router-fusion.ts
COPY lib/router-fusion/gate/passthrough-bridge.ts ./lib/router-fusion/gate/passthrough-bridge.ts
COPY test-fixtures/updates/host-catalog.json ./test-fixtures/updates/host-catalog.json
COPY sidecar/codeserver-agent-ext/tests/fixtures/session-key.vector sidecar/codeserver-agent-ext/tests/fixtures/content-bearer.vector ./sidecar/codeserver-agent-ext/tests/fixtures/
COPY docs/api/mobile-companion-api.openapi.yaml docs/api/headless-service-api.openapi.yaml ./docs/api/
COPY packages/plugin-contract/contract ./packages/plugin-contract/contract
COPY packages/logging/src/schemas/observability-event-v1.schema.json ./packages/logging/src/schemas/observability-event-v1.schema.json
COPY packages/companion-client/src/browser-agent-protocol.json ./packages/companion-client/src/browser-agent-protocol.json
COPY protocol ./protocol
COPY scripts/plugin/node-plugin-host.mjs ./scripts/plugin/node-plugin-host.mjs
# cognia-github-runner embeds the runner definition it installs.
COPY deploy/github-runner/cognia-runner.yml deploy/github-runner/bootstrap.mjs deploy/github-runner/package.json deploy/github-runner/package-lock.json deploy/github-runner/action.yml ./deploy/github-runner/
# container-exec + k8s-exec (R13): the headless image ships both flavors of
# the container backend, so COGNIA_EXEC_BACKEND=container works at T2
# (Docker socket proxy) and =kubernetes at T3 (runner Pods, in-cluster).
RUN /usr/bin/time -v cargo build --release --locked --timings -p cognia-server --bin cognia-server \
    --features container-exec,k8s-exec,workspace-runtime-exec,otel-export \
    ${COGNIA_SERVER_CARGO_FLAGS}
# Agent-first loopback operator CLI. It is intentionally shipped in the same
# image so service-token issuance and the network peer both stay in-container.
RUN /usr/bin/time -v cargo build --release --locked --timings -p cognia-cli --bin cognia
# Small initialization utility: available beside the server before any Node runtime.
RUN /usr/bin/time -v cargo build --release --locked --timings -p cognia-bootstrap-agent --bin cognia-bootstrap
# The Brain layout ships the native helpers the CLI refuses to run without
# (`NATIVE_HOSTS` in scripts/build/ensure-native-hosts.mjs): the external-agent
# launcher, the sandbox exec shim and the task-workspace worker. Build them in
# the Rust stage and pass the artifacts to brain-builder instead of installing
# a second Rust toolchain in the Node stage. The first two live in the
# Tauri-free `cognia-exec-sandbox` (ADR-0196), not the UI-automation crate.
RUN /usr/bin/time -v cargo build --release --locked --timings -p cognia-exec-sandbox \
      --bin cognia-external-agent-launcher --bin cognia-sandbox-exec \
    && /usr/bin/time -v cargo build --release --locked --timings -p cognia-task-workspace --bin cognia-task-workspace-worker

# Export diagnostics without adding compiler artifacts to either runtime image.
FROM scratch AS build-timings
COPY --from=builder /work/target/cargo-timings/ /

# PR CI target: type/borrow-check the whole graph without codegen or linking.
FROM deps AS check
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src-tauri ./src-tauri
COPY crates ./crates
# Out-of-tree include_str! targets (release: browser overlay JS; the spec
# fixtures under cli/ + docs/ are test-cfg but cheap to keep coherent).
COPY lib/browser/overlay.injected.js lib/browser/automation-core.injected.js ./lib/browser/
COPY lib/tauri/selection-toolbar.ts ./lib/tauri/selection-toolbar.ts
COPY lib/plugin/character-pack/__fixtures__/jcs-vectors.json ./lib/plugin/character-pack/__fixtures__/jcs-vectors.json
COPY lib/router-fusion/gate/run-api-bridge.ts ./lib/router-fusion/gate/run-api-bridge.ts
COPY cli/src/x/agent-launcher.ts ./cli/src/x/agent-launcher.ts
COPY cli/src/runtime/external/codex-catalog ./cli/src/runtime/external/codex-catalog
COPY hooks/matcher-conformance.json hooks/builtin-hooks.lockstep.json ./hooks/
COPY test-fixtures/scheduler/cron-dialect.json ./test-fixtures/scheduler/cron-dialect.json
COPY cli/src/serve/fixtures/bridge-frames.json ./cli/src/serve/fixtures/bridge-frames.json
COPY lib/filespace/link-fixtures.json lib/filespace/path-fixtures.json ./lib/filespace/
COPY lib/headless/runtimes/router-fusion.ts ./lib/headless/runtimes/router-fusion.ts
COPY lib/router-fusion/gate/passthrough-bridge.ts ./lib/router-fusion/gate/passthrough-bridge.ts
COPY test-fixtures/updates/host-catalog.json ./test-fixtures/updates/host-catalog.json
COPY sidecar/codeserver-agent-ext/tests/fixtures/session-key.vector sidecar/codeserver-agent-ext/tests/fixtures/content-bearer.vector ./sidecar/codeserver-agent-ext/tests/fixtures/
COPY docs/api/mobile-companion-api.openapi.yaml docs/api/headless-service-api.openapi.yaml ./docs/api/
COPY packages/plugin-contract/contract ./packages/plugin-contract/contract
COPY packages/logging/src/schemas/observability-event-v1.schema.json ./packages/logging/src/schemas/observability-event-v1.schema.json
COPY packages/companion-client/src/browser-agent-protocol.json ./packages/companion-client/src/browser-agent-protocol.json
COPY protocol ./protocol
COPY scripts/plugin/node-plugin-host.mjs ./scripts/plugin/node-plugin-host.mjs
# cognia-github-runner embeds the runner definition it installs.
COPY deploy/github-runner/cognia-runner.yml deploy/github-runner/bootstrap.mjs deploy/github-runner/package.json deploy/github-runner/package-lock.json deploy/github-runner/action.yml ./deploy/github-runner/
RUN cargo check --release --locked -p cognia-server --bin cognia-server --features container-exec,k8s-exec,workspace-runtime-exec,otel-export
RUN cargo check --release --locked -p cognia-cli --bin cognia

# ── Node: brain (cognia-agent) + sidecar bundle ─────────────────────────────
# Full (non-slim) image: node-gyp needs python3/make/g++ for the sidecar's
# native optional deps (node-pty, better-sqlite3).
FROM node:26-trixie AS brain-builder
ARG COREPACK_VERSION=0.35.0
ARG PNPM_VERSION=11.18.0
ARG NPM_CONFIG_REGISTRY
ENV HUSKY=0 \
    CI=1
# Node 25+ no longer bundles Corepack. Pin it explicitly so the Brain image
# keeps using the repository's pinned pnpm even when the Node base moves.
# Fetch runs before package.json exists. Pin Corepack's global fallback too,
# otherwise its shim resolves the latest pnpm instead of PNPM_VERSION.
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN npm install --global "corepack@${COREPACK_VERSION}" \
    && corepack enable pnpm \
    && corepack install --global "pnpm@${PNPM_VERSION}"
WORKDIR /work
# Fetch only from lock/config/patch inputs. Keep the store in this ordinary
# image layer: remote BuildKit layer caches do not export cache-mount contents.
# Workspace source edits therefore reuse downloads even on a fresh CI builder.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN if [ -n "${NPM_CONFIG_REGISTRY}" ]; then \
      registry="${NPM_CONFIG_REGISTRY%/}"; \
      sed -i "s#https://registry.npmjs.org/#${registry}/#g" pnpm-lock.yaml; \
      pnpm config set registry "${registry}"; \
    fi
RUN pnpm fetch --frozen-lockfile --fetch-retries=5 --fetch-timeout=300000 --network-concurrency=16
# Link workspace packages and run approved lifecycle scripts after fetching.
# postinstall's partial-checkout guard defers the separately staged sidecars.
COPY package.json ./
COPY packages ./packages
COPY docs/package.json ./docs/package.json
COPY mobile/package.json ./mobile/package.json
COPY web/package.json ./web/package.json
COPY cli/package.json ./cli/package.json
COPY services/workspace-runtime/package.json ./services/workspace-runtime/package.json
COPY tsconfig.json ./
COPY scripts/postinstall.mjs ./scripts/postinstall.mjs
RUN pnpm install --frozen-lockfile --offline
COPY sidecar/package.json sidecar/pnpm-lock.yaml sidecar/pnpm-workspace.yaml ./sidecar/
# A nested pnpm workspace inherits the repository root policy. Hide the root
# config for this isolated install so sidecar/pnpm-workspace.yaml owns the
# native build approvals, then restore it for the remaining root commands.
RUN --mount=type=cache,id=cognia-pnpm-store,target=/root/.local/share/pnpm/store \
    if [ -n "${NPM_CONFIG_REGISTRY}" ]; then \
      registry="${NPM_CONFIG_REGISTRY%/}"; \
      sed -i "s#https://registry.npmjs.org/#${registry}/#g" sidecar/pnpm-lock.yaml; \
      pnpm config set registry "${registry}"; \
    fi \
    && mv pnpm-workspace.yaml pnpm-workspace.root.yaml \
    && pnpm --dir sidecar install --frozen-lockfile --fetch-retries=5 --fetch-timeout=300000 --network-concurrency=16 \
    && mv pnpm-workspace.root.yaml pnpm-workspace.yaml
RUN apt-get update \
    && apt-get install -y --no-install-recommends zip \
    && rm -rf /var/lib/apt/lists/*
# Sources last; the bundle step reaches cli/ + lib/ + the wider @/* TS graph.
COPY . .
COPY --from=builder /work/target/release/cognia-external-agent-launcher /work/target/release/cognia-sandbox-exec /work/target/release/cognia-task-workspace-worker ./target/release/
# The prebuild script, not a bare `npm ci`: it builds @cognia/network-guard's
# dist/ first, then installs it with --install-links as a physical copy (the
# shape the lockfile records and the bundle layout needs).
RUN node scripts/build/build-webclone-sidecar.mjs
# The sidecar's `link:` workspace packages (@cognia/agent-contracts and the
# other ADR-0217 packages) export compiled `dist/`. A checkout builds it in the
# root postinstall, which ran above before sidecar/ existed and skipped it.
RUN node scripts/build/build-sidecar-linked-packages.mjs
RUN npm --prefix sidecar/vscode-ext-host ci --no-audit --no-fund \
    && npm --prefix sidecar/vscode-ext-host run build
RUN pnpm sidecar:codeserver-agent:build
RUN NODE_OPTIONS=--max-old-space-size=8192 node scripts/build/build-cli-binary.mjs --layout-only

# Pinned managed Pro IDE binary. The release digest is selected per BuildKit
# TARGETARCH and verified before extraction; runtime hosts never download or
# self-upgrade this artifact.
FROM node:26-bookworm-slim AS codeserver-preload
ARG TARGETARCH
ARG CODE_SERVER_VERSION=4.128.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && case "$TARGETARCH" in \
         amd64) digest=79ba26bf186e5268a22b7c17b30a5f288a16c37791f0b86c27859e8fef103188 ;; \
         arm64) digest=f8f02c2a81d1a433a4d132716a6f0405f690f6d70dd955942e95e87356db8a10 ;; \
         *) echo "unsupported code-server architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && asset="code-server-${CODE_SERVER_VERSION}-linux-${TARGETARCH}.tar.gz" \
    && curl --fail --location --proto '=https' --tlsv1.2 \
         "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/${asset}" \
         --output "/tmp/${asset}" \
    && echo "${digest}  /tmp/${asset}" | sha256sum --check --strict \
    && mkdir -p "/opt/cognia/code-server/${CODE_SERVER_VERSION}" \
    && tar -xzf "/tmp/${asset}" --strip-components=1 \
         -C "/opt/cognia/code-server/${CODE_SERVER_VERSION}" \
    && rm -f "/tmp/${asset}"

# The plugin permission model is pinned independently from the brain's Node
# runtime. cognia-plugin-runtime verifies this exact major/minimum patch before
# executing any installed JavaScript plugin.
FROM node:26.12.1-bookworm-slim AS plugin-node-runtime
RUN node --version

# ── Runtime: slim (sidecar-only execution plane) ────────────────────────────
FROM node:26-trixie-slim AS runtime-slim
# The runtime halves of the chef stage's libraries (PipeWire, GBM, EGL,
# Wayland, xkbcommon, OpenSSL) alongside the headless essentials; no GTK or
# WebKitGTK.
# bubblewrap is not optional: cognia-external-agent-launcher (shipped in the
# brain layout below) refuses to spawn without `bwrap` on the PATH, and
# SandboxError has no "continue unsandboxed" variant. Without it EVERY external
# agent on this image — Pi included — fails with "bubblewrap (bwrap) is
# required for strict external-agent hosting". The compose seccomp profile was
# already tuned to let bwrap create user namespaces; only the binary was absent.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libssl3t64 curl git bubblewrap \
       libpipewire-0.3-0t64 libgbm1 libegl1 libwayland-client0 libwayland-server0 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*
# `/data/workspaces` is COGNIA_WORKSPACES_DIR (the per-run writable root the
# sandbox binds) and `/data/pi-home/.pi/agent` is PI_CODING_AGENT_DIR, which
# holds Pi's credentials — both must exist and be writable by the runtime uid
# before the first spawn. Created here, ahead of `VOLUME /data`, so a fresh
# anonymous or empty named volume is seeded with them; a pre-populated volume
# mounted from an older image still needs them created by hand.
# `/workspaces` (+ `/default`) is where the T2 overlay mounts the workspaces
# volumes shared with runners; created here for the same reason, otherwise
# Docker makes a root-owned mount point and the server cannot create its task
# execution root there.
RUN groupadd --system --gid 10001 cognia \
    && useradd --system --uid 10001 --gid cognia --home-dir /data --shell /usr/sbin/nologin cognia \
    && mkdir -p /data /data/workspaces /data/pi-home/.pi/agent /workspaces/default \
    && chown -R cognia:cognia /data /workspaces

COPY --from=builder /work/target/release/cognia-server /usr/local/bin/cognia-server
COPY --from=builder /work/target/release/cognia /usr/local/bin/cognia
COPY --from=builder /work/target/release/cognia-bootstrap /usr/local/bin/cognia-bootstrap
# The layout's sidecar/node_modules already carries webclone's runtime closure
# (its Babel analyzer loads the parser through createRequire), so the image and
# the macOS host archive ship the same tree (ADR-0224 A1).
COPY --from=brain-builder /work/cli/dist/bin/cognia-agent-layout /app/brain
COPY --from=brain-builder /work/sidecar/codeserver-agent-ext/cognia-managed-broker.vsix /opt/cognia/codeserver-agent-ext/cognia-managed-broker.vsix
COPY --from=brain-builder /work/sidecar/codeserver-agent-ext/cognia-managed-broker.vsix.sha256 /opt/cognia/codeserver-agent-ext/cognia-managed-broker.vsix.sha256
COPY --from=codeserver-preload /opt/cognia/code-server /opt/cognia/code-server
COPY --from=plugin-node-runtime /usr/local/bin/node /opt/cognia/plugin-node/bin/node
# Smoke stub agent (ADR-0059 D6): admitted by SpawnPolicy ONLY when
# COGNIA_SMOKE_AGENT=1 is set on the server — inert otherwise.
COPY scripts/smoke/stub-acp-agent.mjs /opt/cognia/smoke/stub-acp-agent.mjs

# NODE_ENV=production disables $COGNIA_PI_EXTENSION_PATH (see
# piExtensionOverrideAllowed): in a shipped image that variable would swap out
# the component holding Pi's native-tool permission gate, which is exactly the
# substitution the digest pin exists to prevent. HOME is set explicitly because
# `USER 10001:10001` does not reliably export the passwd entry's home.
ENV NODE_ENV=production \
    HOME=/data \
    COGNIA_DATA_DIR=/data \
    COGNIA_WORKSPACES_DIR=/data/workspaces \
    PI_CODING_AGENT_DIR=/data/pi-home/.pi/agent \
    COGNIA_BRAIN_ENTRY=/app/brain/cli.mjs \
    COGNIA_PLUGIN_NODE_PATH=/opt/cognia/plugin-node/bin/node \
    COGNIA_SIDECAR_SCRIPT=/app/brain/sidecar/claude-host.mjs \
    COGNIA_VSCODE_EXT_HOST_SCRIPT=/app/brain/sidecar/vscode-ext-host/dist/host.js \
    COGNIA_MCP_SIDECAR_PATH=/app/brain/sidecar/cognia-mcp.mjs
ENV COGNIA_CODE_SERVER_BIN=/opt/cognia/code-server/4.128.0/bin/code-server \
    COGNIA_CODE_SERVER_AGENT_VSIX=/opt/cognia/codeserver-agent-ext/cognia-managed-broker.vsix
# The platform this image is published as in the signed update catalog
# (`oci-<variant>-<arch>`): what its updater and the Compose deploy agent ask
# the catalog for (ADR-0224 A10). The full stage overrides the variant.
ARG TARGETARCH
ENV COGNIA_HOST_TARGET=oci-slim-${TARGETARCH}
VOLUME /data
# 27890 tracks companion_api::server::DEFAULT_PORT — 7890/7891 are the Clash
# mixed/SOCKS defaults and collide with a proxy on most dev hosts.
EXPOSE 27890

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/cognia-server"]
CMD ["serve", "--port", "27890"]

# ── Runtime: full (external agent CLIs preinstalled + git) ──────────────────
FROM runtime-slim AS runtime-full
ARG TARGETARCH
ENV COGNIA_HOST_TARGET=oci-full-${TARGETARCH}
USER root
COPY deploy/runner/install-agents.sh deploy/runner/install-selected.mjs /tmp/
COPY deploy/bundle/agent-versions.json /tmp/agent-versions.json
COPY deploy/bundle/npm/package.json /tmp/agent-packages.json
RUN COGNIA_AGENT_PACKAGE_JSON=/tmp/agent-packages.json \
    COGNIA_AGENT_PINS_JSON=/tmp/agent-versions.json \
    bash /tmp/install-agents.sh \
    && rm -f /tmp/install-agents.sh /tmp/install-selected.mjs /tmp/agent-versions.json /tmp/agent-packages.json \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/cognia/runner/bin:${PATH}"
USER 10001:10001

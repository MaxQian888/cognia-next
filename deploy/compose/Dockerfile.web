# syntax=docker/dockerfile:1.12
## cognia-web — same-origin Web front door (ADR-0059 F2).
##
## Stage 1 builds the Next.js static export (`pnpm build`, output "export")
## with the SAME Node major and the SAME pinned pnpm the repository requires
## (`engines.node` / `packageManager` in package.json) — the brain-builder
## stage of Dockerfile.cognia-server uses the identical recipe. Stage 2 is
## Caddy serving `out/` and reverse-proxying the canonical API/WS/signaling
## paths (see Caddyfile).
##
## Build (repo root is the context; .dockerignore keeps node_modules/out/target
## off the daemon):
##   docker build -f deploy/compose/Dockerfile.web -t cognia-web .
## CI: published as ghcr.io/<owner>/cognia-web by the `cognia-web` matrix
## entry in images.yml.

FROM node:26-bookworm AS web-build
ARG COREPACK_VERSION=0.35.0
ARG PNPM_VERSION=11.18.0
ARG NPM_CONFIG_REGISTRY
# Build-time public configuration baked into the static export.
#   NEXT_PUBLIC_E2E / NEXT_PUBLIC_ACCOUNT_GATE — the CI web-headless lane.
#   NEXT_PUBLIC_E2E_CLOUD_GATE — keeps the cloud sign-in gate live under E2E.
#   NEXT_PUBLIC_COGNIA_LARK_API_BASE — ONLY for a split-origin deployment where
#   the companion API is not served from this same origin (README § Lark).
#   NEXT_PUBLIC_COGNIA_SAME_ORIGIN_HOST — always 1 here: Caddy proxies /api/*
#   to the gateway, so the page's own origin is the deployment to sign in to.
ARG NEXT_PUBLIC_E2E
ARG NEXT_PUBLIC_E2E_CLOUD_GATE
ARG NEXT_PUBLIC_ACCOUNT_GATE
ARG NEXT_PUBLIC_COGNIA_LARK_API_BASE
ARG NEXT_PUBLIC_COGNIA_SAME_ORIGIN_HOST=1
ENV HUSKY=0 \
    CI=true \
    NEXT_PUBLIC_E2E=${NEXT_PUBLIC_E2E} \
    NEXT_PUBLIC_E2E_CLOUD_GATE=${NEXT_PUBLIC_E2E_CLOUD_GATE} \
    NEXT_PUBLIC_ACCOUNT_GATE=${NEXT_PUBLIC_ACCOUNT_GATE} \
    NEXT_PUBLIC_COGNIA_LARK_API_BASE=${NEXT_PUBLIC_COGNIA_LARK_API_BASE} \
    NEXT_PUBLIC_COGNIA_SAME_ORIGIN_HOST=${NEXT_PUBLIC_COGNIA_SAME_ORIGIN_HOST}
# Node 25+ no longer bundles Corepack. Pin both explicitly so the image keeps
# using the repository's pinned pnpm even when the Node base moves.
RUN npm install --global "corepack@${COREPACK_VERSION}" "pnpm@${PNPM_VERSION}"
WORKDIR /app
# Fetch only from lock/config/patch inputs. Keep the store in this ordinary
# image layer: remote BuildKit layer caches do not export cache-mount contents.
# Workspace source edits therefore reuse downloads even on a fresh CI builder.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN if [ -n "${NPM_CONFIG_REGISTRY}" ]; then \
      registry="${NPM_CONFIG_REGISTRY%/}"; \
      sed -i "s#https://registry.npmjs.org/#${registry}/#g" pnpm-lock.yaml; \
      pnpm config set registry "${registry}"; \
    fi
RUN pnpm fetch --frozen-lockfile --fetch-retries=5 --fetch-timeout=300000 --network-concurrency=16
# Link workspace packages and run approved lifecycle scripts after fetching.
# postinstall's partial-checkout guard defers the separately staged sidecars.
COPY package.json ./
COPY packages ./packages
COPY docs/package.json ./docs/package.json
COPY mobile/package.json ./mobile/package.json
COPY scripts/postinstall.mjs ./scripts/postinstall.mjs
RUN pnpm install --frozen-lockfile --offline
# Sources last. prebuild still runs the complete asset and sidecar pipeline.
COPY . .
RUN NODE_OPTIONS=--max-old-space-size=8192 pnpm build

FROM caddy:2.10
COPY deploy/compose/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /app/out /srv

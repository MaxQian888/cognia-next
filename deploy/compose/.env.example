# Copy to .env and fill in. `docker compose up` (no profile) only needs
# SHARE_UPLOAD_SECRET; the `server` profile additionally needs COGNIA_MASTER_KEY.

# ── share (always required) ─────────────────────────────────────────────────
# Bearer secret for share writes/deletes. Generate: openssl rand -hex 32
SHARE_UPLOAD_SECRET=

# ── signaling (optional) ────────────────────────────────────────────────────
# Comma-separated WebSocket Origin allowlist; empty allows all.
SIGNALING_ALLOWED_ORIGINS=

# ── cognia-server (server profile) ──────────────────────────────────────────
# Headless secret-store master key — 64 hex chars (32 bytes). No OS keyring
# exists in a container, so this is mandatory. Generate: openssl rand -hex 32
# Losing it makes the encrypted secret store (device JWTs, provider creds)
# unreadable — treat it like a root password.
COGNIA_MASTER_KEY=
# Public base URL stamped into the pair payload. With the tls profile set this
# to https://<your-domain>; without it, the published 127.0.0.1:27890 default.
# (27890 tracks the companion DEFAULT_PORT — pre-27890 deployments used 7890,
# which collides with the Clash proxy default; re-pair devices after moving.)
COGNIA_PUBLIC_URL=https://127.0.0.1:27890
# Provider key for the sidecar chat turn. Optional — the tier-2 smoke SKIPs the
# chat step (loudly) when unset.
ANTHROPIC_API_KEY=
# Set to 1 ONLY to let the tier-2 smoke's stub ACP agent through SpawnPolicy.
# Leave empty in any real deployment.
COGNIA_SMOKE_AGENT=

# ── Logto IdP (logto profile) ───────────────────────────────────────────────
# Postgres password for the Logto database. Generate: openssl rand -hex 24
LOGTO_DB_PASSWORD=
# Public base URLs for Logto. The OIDC issuer becomes ${LOGTO_ENDPOINT}/oidc.
# For local dev the defaults work; for a real deployment set a reachable
# domain (ideally behind the tls front door). See LOGTO.md.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
# Pin the image in production instead of :latest.
# LOGTO_VERSION=latest

# ── OIDC wiring for cognia-server (set AFTER seeding Logto — see LOGTO.md) ────
# Both issuer AND audience must be set to turn OIDC on. Issuer MUST equal
# ${LOGTO_ENDPOINT}/oidc and be reachable from the cognia-server container.
COGNIA_LOGTO_ISSUER=
# The API resource indicator you created in Logto (the gateway audience).
COGNIA_LOGTO_AUDIENCE=
# Optional: comma/space-separated scopes every request must carry (e.g. brain:rpc).
COGNIA_LOGTO_REQUIRED_SCOPES=
# Optional: JWKS cache TTL in seconds (default 600).
COGNIA_LOGTO_JWKS_TTL_SECS=

# ── Caddy (tls profile) ─────────────────────────────────────────────────────
# Real domain for ACME issuance; use "localhost" for the internal-CA dev path.
COGNIA_DOMAIN=localhost
# Contact email for Let's Encrypt (leave empty for the localhost internal CA).
ACME_EMAIL=

# ── T2 split execution plane (docker-compose.t2.yml overlay) ────────────────
# Runner image for per-agent containers; pulled automatically on first spawn.
# COGNIA_RUNNER_IMAGE=ghcr.io/maxqian888/cognia-runner:latest

# ── Shared remote browser (remote-browser profile; experimental, OFF) ───────
# Both gates are required. Generate the runtime secret with:
#   openssl rand -hex 32
COGNIA_REMOTE_BROWSER_ENABLED=false
COGNIA_WORKSPACE_RUNTIME_SECRET=
COGNIA_WORKSPACE_RUNTIME_WORKSPACES=default
# COGNIA_WORKSPACE_RUNTIME_IMAGE=ghcr.io/maxqian888/cognia-workspace-runtime:latest

# ── image overrides (optional) ──────────────────────────────────────────────
# Point at locally-built images instead of GHCR, e.g. cognia-signaling:dev.
# SIGNALING_IMAGE=
# SHARE_IMAGE=
# COGNIA_SERVER_IMAGE=

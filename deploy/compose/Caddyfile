# Same-origin Web + Companion front door. Caddy serves the static export and
# routes only canonical API/WS/signaling paths to their internal services.

{$COGNIA_DOMAIN:localhost} {
	encode zstd gzip

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@no_cache path *.html /sw.js /service-worker.js
	header @no_cache Cache-Control "no-store"

	@signaling path /signaling* /v2/signaling*
	handle @signaling {
		reverse_proxy signaling:7892
	}

	@headless path /api/* /ws/* /internal/* /operator/* /connectors/* /integrations/* /ide/* /a2a /healthz /livez /readyz /metrics /.well-known/agent-card.json
	handle @headless {
		reverse_proxy https://cognia-server:27890 {
			transport http {
				tls
				tls_trust_pool file /cognia-data/cognia/companion/tls.pem
				tls_server_name localhost
			}
		}
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}

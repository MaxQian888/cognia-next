      "@cognia/diagnostics": ["./packages/diagnostics/src/index.ts"],
      "@cognia/diagnostics/*": ["./packages/diagnostics/src/*"],
      "@cognia/vector": ["./packages/vector/src/index.ts"],
      "@cognia/vector/*": ["./packages/vector/src/*"],
      "@cognia/transformers-runtime": ["./packages/transformers-runtime/src/index.ts"],
      "@cognia/transformers-runtime/*": ["./packages/transformers-runtime/src/*"],
      "@cognia/document": ["./packages/document/src/index.ts"],
      "@cognia/document/*": ["./packages/document/src/*"],
      "@cognia/agent-trace": ["./packages/agent-trace/src/index.ts"],

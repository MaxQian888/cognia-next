{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@cognia/eval-core": ["./packages/eval-core/src/index.ts"],
      "@cognia/eval-core/*": ["./packages/eval-core/src/*"],
      "@cognia/provider-types": ["./packages/provider-types/src/index.ts"],
      "@cognia/provider-types/*": ["./packages/provider-types/src/*"],
      "@cognia/provider-core": ["./packages/provider-core/src/index.ts"],
      "@cognia/provider-core/*": ["./packages/provider-core/src/*"],
      "@cognia/provider-embedding": ["./packages/provider-embedding/src/index.ts"],
      "@cognia/provider-embedding/*": ["./packages/provider-embedding/src/*"],
      "@cognia/provider-routing": ["./packages/provider-routing/src/index.ts"],

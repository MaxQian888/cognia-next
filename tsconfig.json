        "./packages/plugin-sdk/src/api/agent-team-template.ts"
      ],
      "@cognia/plugin-sdk/api/automation": ["./packages/plugin-sdk/src/api/automation.ts"],
      "@cognia/plugin-sdk/api/balance-adapter": [
        "./packages/plugin-sdk/src/api/balance-adapter.ts"
      ],
      "@cognia/plugin-sdk/api/character-pack": ["./packages/plugin-sdk/src/api/character-pack.ts"],

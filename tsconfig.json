{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@cognia/provider-types": ["./packages/provider-types/src/index.ts"],
      "@cognia/provider-types/*": ["./packages/provider-types/src/*"],
      "@cognia/provider-core": ["./packages/provider-core/src/index.ts"],
      "@cognia/provider-core/*": ["./packages/provider-core/src/*"],
      "@cognia/provider-embedding": ["./packages/provider-embedding/src/index.ts"],
      "@cognia/provider-embedding/*": ["./packages/provider-embedding/src/*"],
      "@cognia/provider-routing": ["./packages/provider-routing/src/index.ts"],
      "@cognia/provider-routing/*": ["./packages/provider-routing/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "mobile",
    "sidecar",
    "share-server",
    "out",
    ".next",
    "tests/e2e",
    "playwright.config.ts",
    "packages/*/tsup.config.ts"
  ]
}

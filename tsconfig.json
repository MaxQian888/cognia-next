      "@cognia/latex/*": ["./packages/latex/src/*"],
      "@cognia/mermaid": ["./packages/mermaid/src/index.ts"],
      "@cognia/mermaid/*": ["./packages/mermaid/src/*"],
      "@cognia/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@cognia/plugin-sdk/manifest": ["./packages/plugin-sdk/src/manifest/index.ts"],
      "@cognia/plugin-sdk/context": ["./packages/plugin-sdk/src/context/index.ts"],

      ],
      "@cognia/plugin-sdk/api/message-renderer": [
        "./packages/plugin-sdk/src/api/message-renderer.ts"
      ],
      "@cognia/plugin-sdk/api/ocr-provider": ["./packages/plugin-sdk/src/api/ocr-provider.ts"],
      "@cognia/plugin-sdk/api/sandbox": ["./packages/plugin-sdk/src/api/sandbox.ts"],
      "@cognia/plugin-sdk/api/scheduled-task": ["./packages/plugin-sdk/src/api/scheduled-task.ts"],
      "@cognia/plugin-sdk/api/shared-memory-adapter": [

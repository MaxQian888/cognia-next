{
  "name": "cognia-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/copy-monaco-assets.mjs",
    "prebuild": "node scripts/copy-monaco-assets.mjs && node scripts/build-vscode-ext-host-sidecar.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "monaco:copy": "node scripts/copy-monaco-assets.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "audit:slots": "ts-node --project scripts/tsconfig.audit.json scripts/audit-plugin-slots.ts",
    "audit:silent-flags": "node scripts/check-silent-failure-flags.mjs",
    "lint:i18n": "ts-node --project scripts/tsconfig.audit.json scripts/lint-i18n.ts",
    "lint:i18n:baseline": "ts-node --project scripts/tsconfig.audit.json scripts/lint-i18n.ts --write-baseline",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:workflows": "playwright test tests/e2e/workflows/",
    "test:e2e:workflows:nodes": "playwright test tests/e2e/workflows/nodes/",
    "test:e2e:workflows:editor": "playwright test tests/e2e/workflows/editor/",
    "test:e2e:workflows:runs": "playwright test tests/e2e/workflows/runs/",
    "test:e2e:mobile": "playwright test --project=mobile-pixel-7 tests/e2e/mobile/",
    "test:e2e:mobile:ios": "cross-env PLAYWRIGHT_MOBILE_IOS=1 playwright test --project=mobile-iphone-13 tests/e2e/mobile/",
    "test:e2e:tauri": "cross-env PLAYWRIGHT_TAURI_DRIVER=1 playwright test --project=tauri-driver tests/e2e/tauri/",
    "test:e2e:install": "playwright install chromium webkit",
    "test:e2e:report": "playwright show-report",
    "sidecar:install": "pnpm --dir sidecar install --ignore-workspace",
    "sidecar:start": "node sidecar/claude-host.mjs",
    "sidecar:smoke": "node sidecar/claude-host.mjs --smoke",
    "sidecar:test": "pnpm run sidecar:test:builtin && pnpm run sidecar:test:dispatch",
    "sidecar:test:builtin": "node --test sidecar/builtin-tools/__tests__/*.test.mjs",
    "sidecar:test:dispatch": "node --test sidecar/dispatch/*.test.mjs",
    "sidecar:vscode:install": "node scripts/build-vscode-ext-host-sidecar.mjs --install-only",
    "sidecar:vscode:build": "node scripts/build-vscode-ext-host-sidecar.mjs",
    "sidecar:vscode:test": "npm --prefix sidecar/vscode-ext-host test",
    "sidecar:vscode:clean": "node -e \"require('node:fs').rmSync('sidecar/vscode-ext-host/dist',{recursive:true,force:true})\"",
    "sidecars:install": "pnpm run sidecar:install && pnpm run sidecar:vscode:install",
    "sidecars:build": "pnpm run sidecar:vscode:build",
    "sidecars:test": "pnpm run sidecar:test && pnpm run sidecar:vscode:test",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "docs:start": "pnpm -F docs start",
    "mobile:sync": "pnpm build && pnpm -F mobile sync",
    "mobile:open:ios": "pnpm -F mobile open:ios",
    "mobile:open:android": "pnpm -F mobile open:android"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",

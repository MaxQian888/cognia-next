    "input-otp": "^1.4.2",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.4",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.7.284",
    "qrcode.react": "^4.2.0",

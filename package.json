    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.9",

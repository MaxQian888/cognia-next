    "mobile:open:android": "pnpm -F mobile open:android",
    "mobile:deploy": "pwsh -NoProfile -File mobile/scripts/deploy-android.ps1",
    "mobile:deploy:fast": "pwsh -NoProfile -File mobile/scripts/deploy-android.ps1 -SkipWeb"

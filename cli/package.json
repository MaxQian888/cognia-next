{
  "name": "@cognia/agent-cli",
  "version": "0.1.0",
  "description": "Standalone, desktop-independent Cognia coding agent for the terminal. Reuses the desktop agent loop via the sidecar.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxQian888/cognia-next.git",
    "directory": "cli"
  },
  "keywords": [
    "cognia",
    "agent",
    "cli",
    "coding-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cognia-agent": "./dist/cognia-agent.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cognia/agent": "workspace:*",
    "@cognia/agent-config-types": "workspace:*",
    "@cognia/agent-trace": "workspace:*",
    "@cognia/companion-client": "workspace:*",
    "@cognia/document": "workspace:*",
    "@cognia/eval-core": "workspace:*",
    "@cognia/logging": "workspace:*",
    "@cognia/ocr": "workspace:*",
    "@cognia/plugin-sdk": "workspace:*",
    "@cognia/provider-core": "workspace:*",
    "@cognia/provider-routing": "workspace:*",
    "@cognia/provider-types": "workspace:*",
    "@cognia/redact": "workspace:*",
    "@cognia/security-findings": "workspace:*",
    "@cognia/vector": "workspace:*",
    "@cognia/web-search": "workspace:*"
  }
}

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cognia",
  "version": "0.1.0",
  "identifier": "com.reactquickstarter.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cognia",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../sidecar/claude-host.mjs",
      "../sidecar/package.json",
      "../sidecar/node_modules/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["cognia"]
      }
    },
    "cli": {
      "description": "Cognia desktop client for Claude Code",
      "longDescription": "Run with no arguments to open the main window. Pass a path to open it as a workspace.",
      "args": [
        {
          "name": "workspace",
          "index": 1,
          "takesValue": true,
          "description": "Absolute path to a workspace directory to open on launch"
        },
        {
          "name": "new-chat",
          "short": "n",
          "description": "Open a fresh chat after launch"
        }
      ]
    }
  }
}

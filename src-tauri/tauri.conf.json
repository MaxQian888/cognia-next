{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cognia",
  "version": "0.1.0",
  "identifier": "com.cognia.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm terminal-host:prepare:dev && pnpm external-agent-launcher:prepare:dev && pnpm plugin-node:prepare && node scripts/dev/free-port.mjs 3000 && pnpm dev",
    "beforeBuildCommand": "pnpm terminal-host:prepare && pnpm external-agent-launcher:prepare && pnpm plugin-node:prepare && pnpm build && pnpm tauri:frontend:check"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cognia",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0a0a0a",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 14 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss: https://api.github.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/cognia-server", "binaries/cognia-external-agent-launcher"],
    "targets": "all",
    "resources": [
      "../sidecar/agent-host.mjs",
      "../sidecar/fetch-interceptor.mjs",
      "../sidecar/host-rpc.mjs",
      "../sidecar/telemetry.mjs",
      "../sidecar/claude-host.mjs",
      "../sidecar/a2ui-mcp.mjs",
      "../sidecar/cognia-mcp.mjs",
      "../sidecar/mcp-oauth-helper.mjs",
      "../sidecar/mcp-stdio-relay.mjs",
      "../sidecar/codex-app-control/**/*",
      "../sidecar/pi-extension/**/*",
      "../sidecar/package.json",
      "../sidecar/node_modules/**/*",
      "../sidecar/dispatch/**/*",
      "../sidecar/builtin-tools/**/*",
      "../sidecar/lsp/**/*",
      "../sidecar/a2ui-tools/**/*",
      "../sidecar/vscode-ext-host/package.json",
      "../sidecar/vscode-ext-host/dist/**/*",
      "../sidecar/vscode-ext-host/node_modules/**/*",
      "../sidecar/webclone/package.json",
      "../sidecar/webclone/dist/**/*",
      "../sidecar/webclone/node_modules/**/*",
      "../sidecar/codeserver-agent-ext/cognia-managed-broker.vsix",
      "resources/terminal/shell-integration.bash",
      "resources/terminal/shell-integration.zsh",
      "resources/terminal/shell-integration.ps1",
      "resources/plugin-node/**/*",
      "../hooks/builtin/auto-context-loader.mjs",
      "../hooks/builtin/cost-quota-guard.mjs",
      "../hooks/builtin/pii-safety-guard.mjs",
      "../runtime/deepseek-harness/*",
      "../lib/ai/code-mode/limits.json",
      "../lib/ai/providers/models-dev-capabilities.json",
      "../lib/settings/builtin-tools-data.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.4"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MaxQian888/cognia-next/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQzVDOTEyQTMwODhDMgpSV1RDaURBcWtWd01EY1VhMGpzdFljVTRhV3p2eU40d0VNVk02VDB3M2lmRlVRcytCNFFMQW1BcAo="
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["cognia"]
      }
    },
    "cli": {
      "description": "Cognia desktop client for Claude Code",
      "longDescription": "Run with no arguments to open the main window. Pass a path to open it as a workspace.",
      "args": [
        {
          "name": "workspace",
          "index": 1,
          "takesValue": true,
          "description": "Absolute path to a workspace directory to open on launch"
        },
        {
          "name": "new-chat",
          "short": "n",
          "description": "Open a fresh chat after launch"
        }
      ]
    },
    "shell": {
      "open": true
    }
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island-window",
  "description": "Least-privilege capabilities for the task control island overlay window. Window shape, event listen and a scoped emit-to only; no business commands.",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-inner-size",
    "core:window:allow-set-size",
    "core:window:allow-set-resizable",
    "allow-island-app-commands"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "selection-toolbar-window",
  "description": "Least-privilege capabilities for the transient system text-selection toolbar.",
  "windows": ["selection-toolbar"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "allow-selection-toolbar-app-commands",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
